<%
    const commentItem = comment || {};
    const commentAuthor = commentItem.createdBy.userName || 'Anonymous Reader';
    const commentContent = commentItem.content || 'No comment provided.';
    const commentDateValue = commentItem.createdAt || new Date();
    const commentDate = new Date(commentDateValue);
    const commentDateText = Number.isNaN(commentDate.getTime())
        ? 'Just now'
        : commentDate.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' });
    const isRecent = commentItem.createdAt ? false : true;
%>

<div class="comment-card">
    <div class="comment-header">
        <div class="comment-user">
            <div class="account-btn">
                <img src="<%= commentItem.createdBy.profilePicture %>" alt="Profilepic" class="profilepic"/>
            </div>
            <div class="comment-meta">
                <span class="comment-username"><%= commentAuthor %></span>
                <span class="comment-date">
                    <% if (isRecent) { %>
                        Now • Posted just now
                    <% } else { %>
                        <%= commentDateText %>
                    <% } %>
                </span>
            </div>
        </div>
    </div>

    <p class="comment-content"><%= commentContent %></p>
</div>
