<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&family=Space+Grotesk:wght@400;500;600;700&display=swap" rel="stylesheet">

<script>
    /* Immediate theme application to prevent flash of incorrect theme */
    (function() {
        try {
            var savedTheme = localStorage.getItem('inkora_theme');
            if (savedTheme === 'light' || savedTheme === 'dark') {
                document.documentElement.setAttribute('data-theme', savedTheme);
            } else if (window.matchMedia && window.matchMedia('(prefers-color-scheme: light)').matches) {
                document.documentElement.setAttribute('data-theme', 'light');
            } else {
                document.documentElement.setAttribute('data-theme', 'dark');
            }
        } catch (e) {}
    })();
</script>

<%- include("./animations.ejs") %>

<style>

    /* =========================
       DESIGN TOKENS & THEME PROPERTIES
    ========================== */

    :root,
    [data-theme="dark"] {
        /* Colors */
        --bg-primary: #0a0a0f;
        --bg-secondary: #12121a;
        --bg-card: rgba(255, 255, 255, 0.04);
        --bg-glass: rgba(255, 255, 255, 0.06);
        --bg-glass-hover: rgba(255, 255, 255, 0.1);
        --bg-input: rgba(18, 18, 26, 0.75);
        --bg-input-focus: rgba(26, 26, 38, 0.95);
        --toolbar-bg: rgba(20, 20, 30, 0.85);

        --navbar-bg: rgba(10, 10, 15, 0.7);
        --navbar-scrolled: rgba(10, 10, 15, 0.92);
        --mobile-nav-bg: rgba(10, 10, 15, 0.95);

        --account-menu-bg: rgba(18, 18, 26, 0.96);
        --account-submenu-bg: rgba(26, 26, 38, 0.95);
        --account-menu-shadow: 0 20px 50px rgba(0, 0, 0, 0.5);

        --text-primary: #f0f0f5;
        --text-secondary: #8888a0;
        --text-muted: #55556a;

        --accent-primary: #7c3aed;
        --accent-secondary: #a855f7;
        --accent-tertiary: #c084fc;
        --accent-glow: rgba(124, 58, 237, 0.35);

        --gradient-primary: linear-gradient(135deg, #7c3aed, #a855f7, #c084fc);
        --gradient-accent: linear-gradient(135deg, #6d28d9, #7c3aed);
        --gradient-card-1: linear-gradient(135deg, #7c3aed33, #a855f722);
        --gradient-card-2: linear-gradient(135deg, #06b6d433, #3b82f622);
        --gradient-card-3: linear-gradient(135deg, #f43f5e33, #fb923c22);

        --border-subtle: rgba(255, 255, 255, 0.08);
        --border-accent: rgba(124, 58, 237, 0.3);

        --card-shadow: 0 20px 40px rgba(0, 0, 0, 0.3);
        --hero-card-bg: rgba(255, 255, 255, 0.06);
        --hero-card-text: #ffffff;
        --hero-card-shadow: 0 20px 60px rgba(124, 58, 237, 0.15);
        --hero-tag-bg: rgba(124, 58, 237, 0.15);
        --hero-tag-border: rgba(124, 58, 237, 0.25);
        --article-fade: linear-gradient(transparent, #0a0a0f);
        --scrollbar-track: #0a0a0f;
        --theme-check-color: #a855f7;

        /* Typography */
        --font-body: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
        --font-heading: 'Space Grotesk', sans-serif;

        /* Spacing */
        --section-padding: 100px 8%;
        --card-radius: 20px;
        --btn-radius: 12px;

        /* Transitions */
        --transition-fast: 0.2s cubic-bezier(0.4, 0, 0.2, 1);
        --transition-smooth: 0.4s cubic-bezier(0.4, 0, 0.2, 1);
        --transition-spring: 0.5s cubic-bezier(0.34, 1.56, 0.64, 1);
    }

    [data-theme="light"] {
        /* Colors */
        --bg-primary: #f8f9fd;
        --bg-secondary: #ffffff;
        --bg-card: rgba(0, 0, 0, 0.025);
        --bg-glass: rgba(255, 255, 255, 0.85);
        --bg-glass-hover: rgba(0, 0, 0, 0.05);
        --bg-input: #ffffff;
        --bg-input-focus: #ffffff;
        --toolbar-bg: rgba(243, 244, 248, 0.95);

        --navbar-bg: rgba(248, 249, 253, 0.85);
        --navbar-scrolled: rgba(255, 255, 255, 0.95);
        --mobile-nav-bg: rgba(255, 255, 255, 0.98);

        --account-menu-bg: rgba(255, 255, 255, 0.98);
        --account-submenu-bg: rgba(243, 244, 248, 0.98);
        --account-menu-shadow: 0 20px 45px rgba(0, 0, 0, 0.12);

        --text-primary: #0f172a;
        --text-secondary: #475569;
        --text-muted: #64748b;

        --accent-primary: #7c3aed;
        --accent-secondary: #8b5cf6;
        --accent-tertiary: #7c3aed;
        --accent-glow: rgba(124, 58, 237, 0.25);

        --gradient-primary: linear-gradient(135deg, #7c3aed, #8b5cf6, #a855f7);
        --gradient-accent: linear-gradient(135deg, #6d28d9, #7c3aed);
        --gradient-card-1: linear-gradient(135deg, rgba(124, 58, 237, 0.15), rgba(168, 85, 247, 0.08));
        --gradient-card-2: linear-gradient(135deg, rgba(6, 182, 212, 0.15), rgba(59, 130, 246, 0.08));
        --gradient-card-3: linear-gradient(135deg, rgba(244, 63, 94, 0.15), rgba(251, 146, 60, 0.08));

        --border-subtle: rgba(0, 0, 0, 0.09);
        --border-accent: rgba(124, 58, 237, 0.35);

        --card-shadow: 0 12px 30px rgba(0, 0, 0, 0.06);
        --hero-card-bg: rgba(255, 255, 255, 0.88);
        --hero-card-text: #0f172a;
        --hero-card-shadow: 0 20px 50px rgba(124, 58, 237, 0.12);
        --hero-tag-bg: rgba(124, 58, 237, 0.1);
        --hero-tag-border: rgba(124, 58, 237, 0.25);
        --article-fade: linear-gradient(transparent, #f8f9fd);
        --scrollbar-track: #f1f5f9;
        --theme-check-color: #7c3aed;
    }


    /* =========================
       RESET & BASE
    ========================== */

    * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
    }

    html {
        scroll-behavior: smooth;
    }

    body {
        font-family: var(--font-body);
        background: var(--bg-primary);
        color: var(--text-primary);
        line-height: 1.6;
        overflow-x: hidden;
        transition: background-color var(--transition-smooth), color var(--transition-smooth);
    }

    a {
        text-decoration: none;
        color: inherit;
    }

    button {
        border: none;
        cursor: pointer;
        font-family: inherit;
    }

    ::selection {
        background: var(--accent-primary);
        color: white;
    }

    ::-webkit-scrollbar {
        width: 8px;
    }

    ::-webkit-scrollbar-track {
        background: var(--scrollbar-track);
    }

    ::-webkit-scrollbar-thumb {
        background: var(--accent-primary);
        border-radius: 10px;
    }


    /* =========================
       NAVBAR
    ========================== */

    .navbar {
        position: sticky;
        top: 0;
        z-index: 1000;

        display: flex;
        align-items: center;
        justify-content: space-between;

        padding: 16px 8%;

        background: var(--navbar-bg);
        backdrop-filter: blur(20px);
        -webkit-backdrop-filter: blur(20px);

        border-bottom: 1px solid var(--border-subtle);

        transition: var(--transition-smooth);
    }

    .navbar.scrolled {
        background: var(--navbar-scrolled);
        box-shadow: 0 8px 32px rgba(0, 0, 0, 0.25);
        border-bottom-color: var(--border-accent);
    }


    /* LOGO */

    .logo {
        font-family: var(--font-heading);
        font-size: 1.6rem;
        font-weight: 700;
        letter-spacing: 2px;

        display: flex;
        align-items: center;
        gap: 10px;

        transition: var(--transition-smooth);
    }

    .logo:hover {
        transform: scale(1.03);
    }

    .logo-icon {
        width: 38px;
        height: 38px;

        background: var(--gradient-primary);

        display: flex;
        justify-content: center;
        align-items: center;

        border-radius: 10px;

        font-size: 17px;
        font-weight: 800;
        color: white;

        box-shadow: 0 4px 15px var(--accent-glow);
        transition: var(--transition-smooth);
    }

    .logo:hover .logo-icon {
        box-shadow: 0 6px 25px var(--accent-glow);
        transform: rotate(-5deg);
    }


    /* NAV LINKS */

    .nav-links {
        display: flex;
        gap: 32px;
        list-style: none;
    }

    .nav-links a {
        color: var(--text-secondary);

        font-size: 14px;
        font-weight: 500;

        position: relative;
        padding: 6px 0;

        transition: var(--transition-fast);
    }

    .nav-links a::after {
        content: '';
        position: absolute;
        bottom: 0;
        left: 0;
        width: 0;
        height: 2px;
        background: var(--gradient-primary);
        border-radius: 2px;
        transition: var(--transition-smooth);
    }

    .nav-links a:hover,
    .nav-links a.active {
        color: var(--text-primary);
    }

    .nav-links a:hover::after,
    .nav-links a.active::after {
        width: 100%;
    }


    /* NAV ACTIONS */

    .nav-actions {
        display: flex;
        align-items: center;
        gap: 12px;
    }

    .nav-actions .login-btn {
        background: transparent;
        color: var(--text-secondary);

        font-size: 14px;
        font-weight: 600;

        padding: 10px 18px;
        border-radius: var(--btn-radius);

        transition: var(--transition-fast);
    }

    .nav-actions .login-btn:hover {
        color: var(--text-primary);
        background: var(--bg-glass);
    }

    .nav-actions .signup-btn {
        background: var(--gradient-primary);
        color: white;

        padding: 10px 22px;
        border-radius: var(--btn-radius);

        font-size: 14px;
        font-weight: 600;

        transition: var(--transition-smooth);
        box-shadow: 0 4px 15px var(--accent-glow);
        position: relative;
        overflow: hidden;
    }

    .nav-actions .signup-btn::before {
        content: '';
        position: absolute;
        top: 0; left: -100%;
        width: 100%; height: 100%;
        background: linear-gradient(90deg, transparent, rgba(255,255,255,0.15), transparent);
        transition: var(--transition-smooth);
    }

    .nav-actions .signup-btn:hover {
        transform: translateY(-2px);
        box-shadow: 0 8px 25px var(--accent-glow);
    }

    .nav-actions .signup-btn:hover::before {
        left: 100%;
    }


    /* ACCOUNT */

    .account {
        position: relative;
    }

    .account-btn {
        width: 50px;
        height: 50px;

        border-radius: 50%;
        background: var(--gradient-primary);

        color: white;
        font-weight: bold;
        font-size: 15px;

        overflow: hidden;

        border: 2px solid transparent;
        transition: var(--transition-smooth);
    }

    .account-btn:hover {
        border-color: var(--accent-secondary);
        box-shadow: 0 0 20px var(--accent-glow);
        transform: scale(1.05);
    }

    .profilepic {
        width: 100%;
        height: auto;
        display: block;
    }

    .account-menu {
        position: absolute;
        top: 58px;
        right: 0;

        width: 220px;

        background: var(--account-menu-bg);
        backdrop-filter: blur(20px);
        -webkit-backdrop-filter: blur(20px);

        border: 1px solid var(--border-subtle);
        border-radius: 16px;

        padding: 8px;

        box-shadow: var(--account-menu-shadow);

        opacity: 0;
        visibility: hidden;
        transform: translateY(-10px) scale(0.95);

        transition: var(--transition-smooth);
        z-index: 1001;
    }

    .account-menu.active {
        opacity: 1;
        visibility: visible;
        transform: translateY(0) scale(1);
    }

    .account-menu .menu-link {
        display: flex;
        align-items: center;
        padding: 11px 14px;
        border-radius: 10px;
        font-size: 14px;
        color: var(--text-secondary);
        transition: var(--transition-fast);
    }

    .account-menu .menu-link:hover {
        background: var(--bg-glass-hover);
        color: var(--text-primary);
        transform: translateX(4px);
    }

    /* THEME DROPDOWN / SUBMENU */

    .theme-dropdown-wrapper {
        position: relative;
        width: 100%;
    }

    .theme-toggle-btn {
        width: 100%;
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 11px 14px;
        border-radius: 10px;
        font-size: 14px;
        font-weight: 500;
        color: var(--text-secondary);
        background: transparent;
        transition: var(--transition-fast);
        text-align: left;
    }

    .theme-toggle-label {
        display: flex;
        align-items: center;
    }

    .theme-toggle-btn:hover,
    .theme-toggle-btn.open {
        background: var(--bg-glass-hover);
        color: var(--text-primary);
    }

    .menu-arrow {
        font-size: 16px;
        line-height: 1;
        font-weight: 600;
        color: var(--text-muted);
        transition: transform var(--transition-smooth), color var(--transition-fast);
    }

    .theme-toggle-btn.open .menu-arrow {
        transform: rotate(90deg);
        color: var(--accent-secondary);
    }

    .theme-submenu {
        display: none;
        flex-direction: column;
        gap: 3px;
        margin: 4px 0 6px 0;
        padding: 6px;
        background: var(--account-submenu-bg);
        border: 1px solid var(--border-subtle);
        border-radius: 12px;
        overflow: hidden;
        animation: fadeIn 0.2s ease forwards;
    }

    .theme-submenu.active {
        display: flex;
    }

    .theme-option {
        width: 100%;
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 9px 12px;
        border-radius: 8px;
        font-size: 13px;
        font-weight: 500;
        color: var(--text-secondary);
        background: transparent;
        transition: var(--transition-fast);
        text-align: left;
    }

    .theme-option-left {
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .theme-option-icon {
        font-size: 14px;
    }

    .theme-option:hover {
        background: var(--bg-glass-hover);
        color: var(--text-primary);
        transform: translateX(3px);
    }

    .theme-option.active {
        color: var(--accent-tertiary);
        font-weight: 600;
        background: var(--bg-glass-hover);
    }

    .theme-check {
        font-size: 13px;
        font-weight: 700;
        color: var(--theme-check-color);
        opacity: 0;
        transform: scale(0.6);
        transition: opacity var(--transition-fast), transform var(--transition-fast);
    }

    .theme-option.active .theme-check {
        opacity: 1;
        transform: scale(1);
    }


    /* =========================
       COMMON FLOATING ORBS
    ========================== */

    .orb {
        position: fixed;
        border-radius: 50%;
        filter: blur(80px);
        pointer-events: none;
        z-index: 0;
    }

    .orb-1 {
        width: 480px;
        height: 480px;
        background: rgba(124, 58, 237, 0.12);
        top: -120px;
        right: -100px;
        animation: orbFloat1 14s ease-in-out infinite;
    }

    .orb-2 {
        width: 400px;
        height: 400px;
        background: rgba(59, 130, 246, 0.08);
        bottom: -100px;
        left: -100px;
        animation: orbFloat2 16s ease-in-out infinite;
    }


    /* =========================
       COMMON FORM COMPONENTS & INPUTS
    ========================== */

    .form-card {
        background: var(--bg-glass);
        backdrop-filter: blur(24px);
        -webkit-backdrop-filter: blur(24px);
        border: 1px solid var(--border-subtle);
        border-radius: var(--card-radius);
        box-shadow: var(--card-shadow);
        padding: 40px;
        position: relative;
        overflow: hidden;
        animation: fadeInUp 0.6s ease both;
    }

    .form-card::before {
        content: '';
        position: absolute;
        top: 0; left: 0; right: 0;
        height: 3px;
        background: var(--gradient-primary);
    }

    .form-group {
        margin-bottom: 24px;
        display: flex;
        flex-direction: column;
        gap: 8px;
    }

    .form-label-row {
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .form-label {
        font-size: 14px;
        font-weight: 600;
        letter-spacing: 0.3px;
        color: var(--text-primary);
        display: flex;
        align-items: center;
        gap: 6px;
    }

    .form-label .required-star {
        color: #f43f5e;
    }

    .label-hint {
        font-size: 12px;
        color: var(--text-muted);
        font-weight: 500;
    }

    .text-input {
        width: 100%;
        background: var(--bg-input);
        border: 1px solid var(--border-subtle);
        border-radius: var(--btn-radius);
        padding: 14px 18px;
        color: var(--text-primary);
        font-family: var(--font-body);
        font-size: 15px;
        outline: none;
        transition: var(--transition-fast);
    }

    .text-input:focus {
        border-color: var(--accent-secondary);
        background: var(--bg-input-focus);
        box-shadow: 0 0 0 4px var(--accent-glow);
    }

    .text-input::placeholder {
        color: var(--text-muted);
        opacity: 0.85;
    }

    .suggestion-box {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
        margin-top: 8px;
        align-items: center;
    }

    .suggestion-title {
        font-size: 12px;
        color: var(--text-muted);
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        margin-right: 4px;
    }

    .suggestion-pill {
        background: var(--bg-card);
        border: 1px solid var(--border-subtle);
        color: var(--text-secondary);
        font-size: 12px;
        font-weight: 500;
        padding: 5px 12px;
        border-radius: 20px;
        cursor: pointer;
        transition: var(--transition-fast);
        user-select: none;
    }

    .suggestion-pill:hover {
        background: var(--bg-glass-hover);
        border-color: var(--border-accent);
        color: var(--text-primary);
        transform: translateY(-1px);
    }

    .suggestion-pill.active {
        background: rgba(124, 58, 237, 0.15);
        border-color: var(--accent-secondary);
        color: var(--accent-tertiary);
        font-weight: 600;
    }

    .submit-btn {
        background: var(--gradient-primary);
        color: white;
        padding: 13px 32px;
        border-radius: var(--btn-radius);
        font-size: 15px;
        font-weight: 600;
        border: none;
        cursor: pointer;
        box-shadow: 0 4px 20px var(--accent-glow);
        display: flex;
        align-items: center;
        gap: 8px;
        transition: var(--transition-smooth);
        position: relative;
        overflow: hidden;
    }

    .submit-btn:hover {
        transform: translateY(-2px);
        box-shadow: 0 8px 28px var(--accent-glow);
    }

    .cancel-btn {
        background: transparent;
        border: 1px solid var(--border-subtle);
        color: var(--text-secondary);
        padding: 12px 24px;
        border-radius: var(--btn-radius);
        font-size: 14px;
        font-weight: 600;
        cursor: pointer;
        transition: var(--transition-fast);
    }

    .cancel-btn:hover {
        color: var(--text-primary);
        background: var(--bg-glass-hover);
        border-color: var(--border-accent);
    }


    /* HAMBURGER */

    .menu-btn {
        display: none;
        background: transparent;
        width: 30px;
        height: 24px;
        position: relative;
        cursor: pointer;
    }

    .menu-btn span {
        display: block;
        width: 100%;
        height: 2px;
        background: var(--text-primary);
        border-radius: 2px;
        position: absolute;
        left: 0;
        transition: var(--transition-smooth);
    }

    .menu-btn span:nth-child(1) { top: 0; }
    .menu-btn span:nth-child(2) { top: 50%; transform: translateY(-50%); }
    .menu-btn span:nth-child(3) { bottom: 0; }

    .menu-btn.active span:nth-child(1) {
        top: 50%;
        transform: translateY(-50%) rotate(45deg);
    }

    .menu-btn.active span:nth-child(2) {
        opacity: 0;
        transform: translateX(-20px);
    }

    .menu-btn.active span:nth-child(3) {
        bottom: 50%;
        transform: translateY(50%) rotate(-45deg);
    }


    /* =========================
       HERO SECTION
    ========================== */

    .hero {
        min-height: 85vh;
        position: relative;

        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        text-align: center;

        padding: 100px 8%;

        overflow: hidden;
    }

    .hero-canvas {
        position: absolute;
        inset: 0;
        z-index: 0;
        pointer-events: none;
    }

    .hero-content {
        position: relative;
        z-index: 1;
        max-width: 820px;
        display: flex;
        flex-direction: column;
        align-items: center;
        text-align: center;
    }

    .hero-tag {
        display: inline-flex;
        align-items: center;
        gap: 8px;

        background: var(--hero-tag-bg);
        color: var(--accent-tertiary);
        border: 1px solid var(--hero-tag-border);

        padding: 8px 18px;
        border-radius: 30px;

        font-size: 13px;
        font-weight: 600;

        margin-bottom: 24px;

        animation: fadeInUp 0.6s ease both;
    }

    .hero-tag .tag-dot {
        width: 8px;
        height: 8px;
        background: var(--accent-secondary);
        border-radius: 50%;
        animation: pulse 2s infinite;
    }

    .hero h1 {
        font-family: var(--font-heading);
        font-size: clamp(2.8rem, 5.5vw, 5rem);
        font-weight: 700;
        line-height: 1.08;
        letter-spacing: -2px;

        margin-bottom: 24px;

        animation: fadeInUp 0.6s ease 0.15s both;
    }

    .hero h1 .gradient-text {
        background: var(--gradient-primary);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
    }

    .hero-content > p {
        color: var(--text-secondary);
        max-width: 580px;
        font-size: 18px;
        line-height: 1.7;
        margin-bottom: 36px;

        animation: fadeInUp 0.6s ease 0.3s both;
    }

    .hero-buttons {
        display: flex;
        justify-content: center;
        gap: 14px;
        flex-wrap: wrap;

        animation: fadeInUp 0.6s ease 0.45s both;
    }

    .primary-btn {
        background: var(--gradient-primary);
        color: white;

        padding: 14px 28px;
        border-radius: var(--btn-radius);

        font-weight: 600;
        font-size: 15px;

        position: relative;
        overflow: hidden;

