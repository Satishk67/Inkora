<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Create Story | INKORA</title>
    <meta name="description" content="Write and publish a new story on INKORA. Share your perspectives and insights with a community of thinkers.">

    <!-- Common Styles, Fonts, Animations & Theme Tokens -->
    <%- include("./partials/style.ejs") %>

    <!-- Page Specific Styles (Story Editor) -->
    <style>
        .editor-nav {
            position: sticky;
            top: 0;
            z-index: 100;
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 16px 8%;
            background: var(--navbar-bg);
            backdrop-filter: blur(20px);
            -webkit-backdrop-filter: blur(20px);
            border-bottom: 1px solid var(--border-subtle);
            transition: var(--transition-smooth);
        }

        .back-link {
            color: var(--text-secondary);
            text-decoration: none;
            font-size: 14px;
            font-weight: 500;
            display: flex;
            align-items: center;
            gap: 6px;
            padding: 8px 14px;
            border-radius: 10px;
            transition: var(--transition-fast);
        }

        .back-link:hover {
            color: var(--text-primary);
            background: var(--bg-glass-hover);
        }

        .editor-wrapper {
            position: relative;
            z-index: 1;
            max-width: 960px;
            margin: 40px auto 80px;
            padding: 0 24px;
        }

        .page-header {
            margin-bottom: 32px;
            text-align: center;
        }

        .header-tag {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            background: var(--hero-tag-bg);
            color: var(--accent-tertiary);
            border: 1px solid var(--hero-tag-border);
            padding: 6px 16px;
            border-radius: 20px;
            font-size: 13px;
            font-weight: 600;
            margin-bottom: 16px;
        }

        .header-tag .dot {
            width: 7px;
            height: 7px;
            background: var(--accent-secondary);
            border-radius: 50%;
            animation: pulse 2s infinite;
        }

        .page-header h1 {
            font-family: var(--font-heading);
            font-size: clamp(2rem, 3.5vw, 2.8rem);
            font-weight: 700;
            letter-spacing: -1px;
            margin-bottom: 10px;
        }

        .page-header p {
            color: var(--text-secondary);
            font-size: 16px;
        }

        /* THUMBNAIL FILE UPLOAD ZONE & PREVIEW */
        .thumbnail-layout {
            display: grid;
            grid-template-columns: 1fr 240px;
            gap: 20px;
            align-items: start;
        }

        .file-upload-zone {
            width: 100%;
            border: 2px dashed var(--border-subtle);
            border-radius: var(--btn-radius);
            background: var(--bg-input);
            padding: 28px 20px;
            text-align: center;
            cursor: pointer;
            transition: var(--transition-fast);
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            gap: 8px;
        }

        .file-upload-zone:hover,
        .file-upload-zone.dragover {
            border-color: var(--accent-secondary);
            background: var(--bg-glass-hover);
            transform: translateY(-2px);
            box-shadow: 0 8px 25px var(--accent-glow);
        }

        .upload-icon {
            font-size: 28px;
            width: 52px;
            height: 52px;
            background: rgba(124, 58, 237, 0.12);
            border: 1px solid rgba(124, 58, 237, 0.25);
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            color: var(--accent-tertiary);
            margin-bottom: 4px;
        }

        .upload-text {
            font-size: 14px;
            font-weight: 600;
            color: var(--text-primary);
        }

        .upload-text span {
            color: var(--accent-secondary);
            text-decoration: underline;
        }

        .upload-hint {
            font-size: 12px;
            color: var(--text-muted);
        }

        .selected-file-chip {
            display: none;
            align-items: center;
            justify-content: space-between;
            background: var(--bg-card);
            border: 1px solid var(--border-accent);
            padding: 8px 14px;
            border-radius: 10px;
            margin-top: 10px;
            font-size: 13px;
        }

        .selected-file-chip.active {
            display: flex;
        }

        .file-name-display {
            display: flex;
            align-items: center;
            gap: 8px;
            color: var(--text-primary);
            font-weight: 500;
            overflow: hidden;
            text-overflow: ellipsis;
            white-space: nowrap;
            max-width: 80%;
        }

        .file-remove-btn {
            background: transparent;
            border: none;
            color: #f43f5e;
            font-size: 12px;
            font-weight: 600;
            cursor: pointer;
            padding: 4px 8px;
            border-radius: 6px;
            transition: var(--transition-fast);
        }

        .file-remove-btn:hover {
            background: rgba(244, 63, 94, 0.15);
        }

        .thumbnail-preview-box {
            height: 146px;
            background: var(--bg-input);
            border: 1px dashed var(--border-subtle);
            border-radius: var(--btn-radius);
            overflow: hidden;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            position: relative;
            transition: var(--transition-fast);
        }

        .thumbnail-preview-box.has-image {
            border-style: solid;
            border-color: var(--border-accent);
        }

        .thumbnail-img {
            width: 100%;
            height: 100%;
            object-fit:fill;
            display: none;
        }

        .preview-placeholder {
            text-align: center;
            color: var(--text-muted);
            font-size: 11px;
            padding: 10px;
        }

        .preview-placeholder span {
            display: block;
            font-size: 28px;
            margin-bottom: 6px;
        }

        /* EDITOR CONTAINER & TOOLBAR */
        .editor-container {
            border: 1px solid var(--border-subtle);
            border-radius: var(--btn-radius);
            overflow: hidden;
            background: var(--bg-input);
            transition: var(--transition-fast);
        }

        .editor-container:focus-within {
            border-color: var(--accent-secondary);
            box-shadow: 0 0 0 4px var(--accent-glow);
        }

        .editor-toolbar {
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 8px 12px;
            background: var(--toolbar-bg);
            border-bottom: 1px solid var(--border-subtle);
            flex-wrap: wrap;
            gap: 6px;
        }

        .toolbar-group {
            display: flex;
            align-items: center;
            gap: 4px;
            flex-wrap: wrap;
        }

        .toolbar-btn {
            background: transparent;
            border: 1px solid transparent;
            color: var(--text-secondary);
            padding: 6px 9px;
            border-radius: 8px;
            font-size: 13px;
            font-weight: 600;
            cursor: pointer;
            transition: var(--transition-fast);
            display: flex;
            align-items: center;
            justify-content: center;
            min-width: 32px;
            height: 32px;
        }

        .toolbar-btn:hover {
            background: var(--bg-glass-hover);
            color: var(--text-primary);
            border-color: var(--border-subtle);
        }

        .toolbar-divider {
            width: 1px;
            height: 20px;
            background: var(--border-subtle);
            margin: 0 4px;
        }

        .tab-group {
            display: flex;
            background: var(--bg-card);
            padding: 3px;
            border-radius: 8px;
            border: 1px solid var(--border-subtle);
        }

        .tab-btn {
            background: transparent;
            border: none;
            color: var(--text-secondary);
            font-size: 12px;
            font-weight: 600;
            padding: 5px 12px;
            border-radius: 6px;
            cursor: pointer;
            transition: var(--transition-fast);
        }

        .tab-btn.active {
            background: var(--accent-primary);
            color: white;
        }

        /* TEXTAREA & PREVIEW PANE */
        .content-textarea {
            width: 100%;
            background: transparent;
            border: none;
            padding: 18px;
            color: var(--text-primary);
            font-family: var(--font-body);
            font-size: 15px;
            line-height: 1.7;
            resize: vertical;
            min-height: 320px;
            outline: none;
        }

        .content-textarea::placeholder {
            color: var(--text-muted);
            line-height: 1.7;
        }

        .content-preview {
            display: none;
            padding: 24px;
            min-height: 320px;
            background: var(--bg-primary);
            color: var(--text-primary);
            font-size: 15px;
            line-height: 1.75;
            overflow-y: auto;
        }

        .content-preview.active {
            display: block;
        }

        .content-preview h1, .content-preview h2, .content-preview h3 {
            font-family: var(--font-heading);
            margin: 18px 0 10px;
            color: var(--text-primary);
        }

        .content-preview p {
            margin-bottom: 14px;
        }

        .content-preview blockquote {
            border-left: 3px solid var(--accent-primary);
            padding-left: 16px;
            margin: 16px 0;
            color: var(--text-secondary);
            font-style: italic;
            background: rgba(124, 58, 237, 0.06);
            border-radius: 0 8px 8px 0;
            padding-top: 8px;
            padding-bottom: 8px;
        }

        .content-preview code {
            font-family: 'Fira Code', monospace;
            background: var(--bg-card);
            border: 1px solid var(--border-subtle);
            padding: 2px 6px;
            border-radius: 5px;
            font-size: 13px;
            color: var(--accent-tertiary);
        }

        .content-preview pre {
            background: rgba(0, 0, 0, 0.3);
            border: 1px solid var(--border-subtle);
            padding: 14px;
            border-radius: 10px;
            overflow-x: auto;
            margin: 16px 0;
        }

        .content-preview pre code {
            background: transparent;
            border: none;
            padding: 0;
            color: inherit;
        }

        .content-preview ul, .content-preview ol {
            margin: 12px 0 16px 24px;
        }

        .content-preview li {
            margin-bottom: 6px;
        }

        .content-preview hr {
            border: none;
            height: 1px;
            background: var(--border-subtle);
            margin: 24px 0;
        }

        .editor-stats {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 8px 16px;
            background: var(--toolbar-bg);
            border-top: 1px solid var(--border-subtle);
            font-size: 12px;
            color: var(--text-muted);
            font-weight: 500;
        }

        .stats-left {
            display: flex;
            gap: 16px;
        }

        .form-actions {
            display: flex;
            align-items: center;
            justify-content: flex-end;
            gap: 14px;
            margin-top: 36px;
            padding-top: 24px;
            border-top: 1px solid var(--border-subtle);
        }

        @media (max-width: 768px) {
            .form-card {
                padding: 24px 18px;
            }

            .thumbnail-layout {
                grid-template-columns: 1fr;
            }

            .thumbnail-preview-box {
                height: 160px;
            }

            .form-actions {
                flex-direction: column-reverse;
            }

            .form-actions button {
                width: 100%;
                justify-content: center;
            }
        }
    </style>
</head>

<body>

    <!-- FLOATING ORBS -->
    <div class="orb orb-1"></div>
    <div class="orb orb-2"></div>

    <!-- NAVIGATION HEADER -->
    <nav class="editor-nav">
        <a href="/" class="logo">
            <div class="logo-icon">I</div>
            INKORA
        </a>

        <div class="nav-actions">
            <button type="button" class="theme-toggle-btn" id="themeToggleBtn" title="Toggle Light/Dark Theme">
                <span id="themeIcon">🌓</span>
                <span id="themeText">Theme</span>
            </button>

            <a href="/" class="back-link">
                ← Back to Home
            </a>
        </div>
    </nav>

    <!-- MAIN FORM CONTAINER -->
    <main class="editor-wrapper">

        <div class="page-header">
            <div class="header-tag">
                <span class="dot"></span>
                Story Creator Studio
            </div>
            <h1>Publish a New Story</h1>
            <p>Share your perspective, research, and stories with curious minds across the world.</p>
        </div>

        <div class="form-card">

            <form action="/blogs/create" method="POST"  id="blogPostForm" enctype="multipart/form-data">

                <!-- 1. CATEGORY (SIMPLE INPUT WITH SUGGESTIONS, NO OPTIONS) -->
                <div class="form-group">
                    <div class="form-label-row">
                        <label for="category" class="form-label">
                            Category <span class="required-star">*</span>
                        </label>
                        <span class="label-hint">Type or click a suggestion</span>
                    </div>

                    <input
                        type="text"
                        id="category"
                        name="category"
                        class="text-input"
                        required
                        placeholder="e.g. Technology, Startups, Productivity, Design, AI..."
                        autocomplete="off"
                    >

                    <!-- CATEGORY SUGGESTION PILLS -->
                    <div class="suggestion-box">
                        <span class="suggestion-title">Suggestions:</span>
                        <button type="button" class="suggestion-pill" data-value="Technology">💡 Technology</button>
                        <button type="button" class="suggestion-pill" data-value="Artificial Intelligence">🤖 AI</button>
                        <button type="button" class="suggestion-pill" data-value="Startups">🚀 Startups</button>
                        <button type="button" class="suggestion-pill" data-value="Programming">💻 Programming</button>
                        <button type="button" class="suggestion-pill" data-value="Productivity">📚 Productivity</button>
                        <button type="button" class="suggestion-pill" data-value="Design">🎨 Design</button>
                        <button type="button" class="suggestion-pill" data-value="Psychology">🧠 Psychology</button>
                        <button type="button" class="suggestion-pill" data-value="Finance">💰 Finance</button>
                        <button type="button" class="suggestion-pill" data-value="Lifestyle">🌱 Lifestyle</button>
                    </div>
                </div>


                <!-- 2. TITLE -->
                <div class="form-group">
                    <div class="form-label-row">
                        <label for="title" class="form-label">
                            Story Title <span class="required-star">*</span>
                        </label>
                        <span class="label-hint" id="titleCharCount">0 / 120 chars</span>
                    </div>

                    <input
                        type="text"
                        id="title"
                        name="title"
                        class="text-input"
                        required
                        maxlength="120"
                        placeholder="e.g. The Art of Deep Focus in an Age of Infinite Distractions"
                        autocomplete="off"
                    >

                    <!-- TITLE STARTER SUGGESTIONS -->
                    <div class="suggestion-box">
                        <span class="suggestion-title">Starters:</span>
                        <button type="button" class="suggestion-pill title-starter" data-starter="How I Built ">"How I Built..."</button>
                        <button type="button" class="suggestion-pill title-starter" data-starter="The Hidden Truth About ">"The Hidden Truth..."</button>
                        <button type="button" class="suggestion-pill title-starter" data-starter="10 Lessons I Learned From ">"10 Lessons From..."</button>
                        <button type="button" class="suggestion-pill title-starter" data-starter="Why Most People Struggle With ">"Why Most People..."</button>
                    </div>
                </div>


                <!-- 3. THUMBNAIL (FILE UPLOAD WITH LIVE PREVIEW) -->
                <div class="form-group">
                    <div class="form-label-row">
                        <label class="form-label">
                            Thumbnail Cover Image <span>*</span>
                        </label>
                        <span class="label-hint">Upload image (PNG, JPG, WEBP)</span>
                    </div>

                    <div class="thumbnail-layout">
                        <div>
                            <!-- Hidden Native File Input -->
                            <input
                                type="file"
                                id="thumbnail"
                                name="thumbnail"
                                accept="image/*"
                                style="display: none;"
                            >

                            <!-- Styled Clickable / Drag-and-Drop Upload Zone -->
                            <div class="file-upload-zone" id="fileUploadZone">
                                <div class="upload-icon">📁</div>
                                <p class="upload-text">
                                    <span>Click to upload</span> or drag and drop
                                </p>
                                <p class="upload-hint">SVG, PNG, JPG, WEBP or GIF (16:9 ratio recommended)</p>
                            </div>

                            <!-- Selected File Chip -->
                            <div class="selected-file-chip" id="selectedFileChip">
                                <div class="file-name-display">
                                    <span>🖼️</span>
                                    <span id="selectedFileName">filename.png</span>
                                </div>
                                <button type="button" class="file-remove-btn" id="fileRemoveBtn">✕ Remove</button>
                            </div>
                        </div>

                        <!-- LIVE IMAGE PREVIEW BOX -->
                        <div class="thumbnail-preview-box" id="thumbnailPreviewBox">
                            <img src="" alt="Thumbnail preview" id="thumbnailImg" class="thumbnail-img">
                            <div class="preview-placeholder" id="thumbnailPlaceholder">
                                <span>🖼️</span>
                                Image preview will appear here
                            </div>
                        </div>
                    </div>
                </div>


                <!-- 4. CONTENT (WITH FORMATTING TOOLBAR & PREVIEW) -->
                <div class="form-group">
                    <div class="form-label-row">
                        <label for="content" class="form-label">
                            Story Content <span class="required-star">*</span>
                        </label>
                        <span class="label-hint">Markdown formatting supported</span>
                    </div>

                    <div class="editor-container">

                        <!-- FORMATTING TOOLBAR -->
                        <div class="editor-toolbar">
                            <div class="toolbar-group">
                                <button type="button" class="toolbar-btn" data-format="bold" title="Bold (**text**)"><strong>B</strong></button>
                                <button type="button" class="toolbar-btn" data-format="italic" title="Italic (*text*)"><em>I</em></button>
                                <div class="toolbar-divider"></div>
                                <button type="button" class="toolbar-btn" data-format="h1" title="Heading 1 (# Heading)">H1</button>
                                <button type="button" class="toolbar-btn" data-format="h2" title="Heading 2 (## Heading)">H2</button>
                                <button type="button" class="toolbar-btn" data-format="h3" title="Heading 3 (### Heading)">H3</button>
                                <div class="toolbar-divider"></div>
                                <button type="button" class="toolbar-btn" data-format="quote" title="Quote (> Quote)">“ ”</button>
                                <button type="button" class="toolbar-btn" data-format="ul" title="Bulleted List (- item)">• List</button>
                                <button type="button" class="toolbar-btn" data-format="ol" title="Numbered List (1. item)">1. List</button>
                                <button type="button" class="toolbar-btn" data-format="code" title="Inline Code (`code`)">&lt;/&gt;</button>
                                <button type="button" class="toolbar-btn" data-format="codeblock" title="Code Block (```)">{ }</button>
                                <button type="button" class="toolbar-btn" data-format="link" title="Insert Link ([title](url))">🔗</button>
                                <button type="button" class="toolbar-btn" data-format="hr" title="Horizontal Rule (---)">―</button>
                            </div>

                            <div class="tab-group">
                                <button type="button" class="tab-btn active" id="writeTabBtn">✏️ Write</button>
                                <button type="button" class="tab-btn" id="previewTabBtn">👁️ Preview</button>
                            </div>
                        </div>

                        <!-- TEXTAREA -->
                        <textarea
                            id="content"
                            name="content"
                            class="content-textarea"
                            required
                            placeholder="Write your story here... Share your knowledge, research, experiences, or insights.&#10;&#10;Use the formatting bar above to add headings, bold/italic text, quotes, bullet points, and code blocks.&#10;&#10;Suggested Outline:&#10;• Introduction: Capture attention and introduce your core idea&#10;• Key Points: Elaborate with examples, data, or storytelling&#10;• Conclusion: Final takeaways and questions for discussion"
                        ></textarea>

                        <!-- LIVE PREVIEW PANE -->
                        <div id="contentPreview" class="content-preview"></div>

                        <!-- STATS FOOTER -->
                        <div class="editor-stats">
                            <div class="stats-left">
                                <span id="wordCount">0 words</span>
                                <span id="charCount">0 characters</span>
                            </div>
                            <div class="stats-right">
                                <span id="readTime">~0 min read</span>
                            </div>
                        </div>

                    </div>
                </div>


                <!-- SUBMISSION BUTTONS -->
                <div class="form-actions">
                    <button type="button" class="cancel-btn" id="resetBtn">
                        Clear Fields
                    </button>

                    <button type="submit" class="submit-btn" id="submitBtn">
                        <span>Publish Story</span>
                        <span>🚀</span>
                    </button>
                </div>

            </form>

        </div>

    </main>

    <!-- JAVASCRIPT LOGIC -->
    <script>
        document.addEventListener('DOMContentLoaded', () => {

            const categoryInput = document.getElementById('category');
            const titleInput = document.getElementById('title');
            const thumbnailInput = document.getElementById('thumbnail');
            const fileUploadZone = document.getElementById('fileUploadZone');
            const selectedFileChip = document.getElementById('selectedFileChip');
            const selectedFileName = document.getElementById('selectedFileName');
            const fileRemoveBtn = document.getElementById('fileRemoveBtn');

            const contentTextarea = document.getElementById('content');
            const thumbnailImg = document.getElementById('thumbnailImg');
            const thumbnailPlaceholder = document.getElementById('thumbnailPlaceholder');
            const thumbnailPreviewBox = document.getElementById('thumbnailPreviewBox');

            const writeTabBtn = document.getElementById('writeTabBtn');
            const previewTabBtn = document.getElementById('previewTabBtn');
            const contentPreview = document.getElementById('contentPreview');

            const titleCharCount = document.getElementById('titleCharCount');
            const wordCountSpan = document.getElementById('wordCount');
            const charCountSpan = document.getElementById('charCount');
            const readTimeSpan = document.getElementById('readTime');
            const resetBtn = document.getElementById('resetBtn');

            const themeToggleBtn = document.getElementById('themeToggleBtn');
            const themeIcon = document.getElementById('themeIcon');


            // 1. CATEGORY SUGGESTION PILLS (Simple input, no dropdown options)
            document.querySelectorAll('.suggestion-pill[data-value]').forEach((pill) => {
                pill.addEventListener('click', () => {
                    const val = pill.getAttribute('data-value');
                    categoryInput.value = val;
                    categoryInput.focus();
                    document.querySelectorAll('.suggestion-pill[data-value]').forEach(p => p.classList.remove('active'));
                    pill.classList.add('active');
                });
            });

            categoryInput.addEventListener('input', () => {
                const currentVal = categoryInput.value.trim().toLowerCase();
                document.querySelectorAll('.suggestion-pill[data-value]').forEach((pill) => {
                    if (pill.getAttribute('data-value').toLowerCase() === currentVal) {
                        pill.classList.add('active');
                    } else {
                        pill.classList.remove('active');
                    }
                });
            });


            // 2. TITLE STARTERS
            document.querySelectorAll('.title-starter').forEach((starterBtn) => {
                starterBtn.addEventListener('click', () => {
                    const starter = starterBtn.getAttribute('data-starter');
                    titleInput.value = starter;
                    titleInput.focus();
                    updateTitleStats();
                });
            });

            function updateTitleStats() {
                const len = titleInput.value.length;
                titleCharCount.textContent = `${len} / 120 chars`;
            }

            titleInput.addEventListener('input', updateTitleStats);


            // 3. THUMBNAIL FILE UPLOAD & LIVE PREVIEW
            fileUploadZone.addEventListener('click', () => {
                thumbnailInput.click();
            });

            // Drag and Drop
            ['dragenter', 'dragover'].forEach(eventName => {
                fileUploadZone.addEventListener(eventName, (e) => {
                    e.preventDefault();
                    e.stopPropagation();
                    fileUploadZone.classList.add('dragover');
                }, false);
            });

            ['dragleave', 'drop'].forEach(eventName => {
                fileUploadZone.addEventListener(eventName, (e) => {
                    e.preventDefault();
                    e.stopPropagation();
                    fileUploadZone.classList.remove('dragover');
                }, false);
            });

            fileUploadZone.addEventListener('drop', (e) => {
                const dt = e.dataTransfer;
                const files = dt.files;
                if (files && files.length > 0) {
                    thumbnailInput.files = files;
                    handleFileSelection(files[0]);
                }
            });

            thumbnailInput.addEventListener('change', () => {
                if (thumbnailInput.files && thumbnailInput.files[0]) {
                    handleFileSelection(thumbnailInput.files[0]);
                }
            });

            function handleFileSelection(file) {
                if (!file.type.startsWith('image/')) {
                    alert('Please select an image file (PNG, JPG, WEBP, etc.)');
                    clearThumbnailSelection();
                    return;
                }

                selectedFileName.textContent = `${file.name} (${(file.size / 1024).toFixed(1)} KB)`;
                selectedFileChip.classList.add('active');

                const reader = new FileReader();
                reader.onload = (e) => {
                    thumbnailImg.src = e.target.result;
                    thumbnailImg.style.display = 'block';
                    thumbnailPlaceholder.style.display = 'none';
                    thumbnailPreviewBox.classList.add('has-image');
                };
                reader.readAsDataURL(file);
            }

            function clearThumbnailSelection() {
                thumbnailInput.value = '';
                thumbnailImg.src = '';
                thumbnailImg.style.display = 'none';
                thumbnailPlaceholder.style.display = 'block';
                thumbnailPlaceholder.innerHTML = '<span>🖼️</span> Image preview will appear here';
                thumbnailPreviewBox.classList.remove('has-image');
                selectedFileChip.classList.remove('active');
            }

            fileRemoveBtn.addEventListener('click', (e) => {
                e.stopPropagation();
                clearThumbnailSelection();
            });


            // 4. CONTENT STATS (WORDS, CHARS, READING TIME)
            function updateContentStats() {
                const text = contentTextarea.value;
                const chars = text.length;
                const words = text.trim() === '' ? 0 : text.trim().split(/\s+/).length;
                const readingTime = Math.ceil(words / 200);

                wordCountSpan.textContent = `${words} word${words === 1 ? '' : 's'}`;
                charCountSpan.textContent = `${chars} character${chars === 1 ? '' : 's'}`;
                readTimeSpan.textContent = `~${readingTime} min read`;
            }

            contentTextarea.addEventListener('input', updateContentStats);


            // 5. FORMATTING TOOLBAR HELPERS
            function insertFormatting(type) {
                const start = contentTextarea.selectionStart;
                const end = contentTextarea.selectionEnd;
                const text = contentTextarea.value;
                const selectedText = text.substring(start, end);

                let replacement = '';

                switch (type) {
                    case 'bold':
                        replacement = `**${selectedText || 'bold text'}**`;
                        break;
                    case 'italic':
                        replacement = `*${selectedText || 'italic text'}*`;
                        break;
                    case 'h1':
                        replacement = `\n# ${selectedText || 'Heading 1'}\n`;
                        break;
                    case 'h2':
                        replacement = `\n## ${selectedText || 'Heading 2'}\n`;
                        break;
                    case 'h3':
                        replacement = `\n### ${selectedText || 'Heading 3'}\n`;
                        break;
                    case 'quote':
                        replacement = `\n> ${selectedText || 'Quoted insight or perspective'}\n`;
                        break;
                    case 'ul':
                        replacement = `\n- ${selectedText || 'List item'}\n- Second item\n`;
                        break;
                    case 'ol':
                        replacement = `\n1. ${selectedText || 'First step'}\n2. Second step\n`;
                        break;
                    case 'code':
                        replacement = `\`${selectedText || 'code'}\``;
                        break;
                    case 'codeblock':
                        replacement = `\n\`\`\`javascript\n${selectedText || '// Write code here'}\n\`\`\`\n`;
                        break;
                    case 'link':
                        replacement = `[${selectedText || 'Link Title'}](https://example.com)`;
                        break;
                    case 'hr':
                        replacement = `\n---\n`;
                        break;
                }

                contentTextarea.setRangeText(replacement, start, end, 'end');
                contentTextarea.focus();
                updateContentStats();
            }

            document.querySelectorAll('.toolbar-btn[data-format]').forEach((btn) => {
                btn.addEventListener('click', () => {
                    const format = btn.getAttribute('data-format');
                    insertFormatting(format);
                });
            });


            // 6. SIMPLE MARKDOWN-TO-HTML CONVERTER FOR PREVIEW
            function renderMarkdown(md) {
                if (!md || md.trim() === '') {
                    return '<p style="color: var(--text-muted); font-style: italic;">Nothing to preview yet. Start typing your story in the Write tab!</p>';
                }

                let html = md
                    .replace(/&/g, '&amp;')
                    .replace(/</g, '&lt;')
                    .replace(/>/g, '&gt;')
                    .replace(/```([\s\S]*?)```/g, '<pre><code>$1</code></pre>')
                    .replace(/`([^`]+)`/g, '<code>$1</code>')
                    .replace(/^### (.*$)/gim, '<h3>$1</h3>')
                    .replace(/^## (.*$)/gim, '<h2>$1</h2>')
                    .replace(/^# (.*$)/gim, '<h1>$1</h1>')
                    .replace(/^\> (.*$)/gim, '<blockquote>$1</blockquote>')
                    .replace(/^---$/gim, '<hr>')
                    .replace(/\*\*(.*?)\*\*/g, '<strong>$1</strong>')
                    .replace(/\*(.*?)\*/g, '<em>$1</em>')
                    .replace(/\[([^\]]+)\]\(([^)]+)\)/g, '<a href="$2" target="_blank" rel="noopener noreferrer" style="color: var(--accent-secondary); text-decoration: underline;">$1</a>')
                    .replace(/^\- (.*$)/gim, '<li>$1</li>')
                    .replace(/(<li>.*<\/li>)/gim, '<ul>$1</ul>')
                    .replace(/\n\n/g, '</p><p>')
                    .replace(/\n/g, '<br>');

                return `<p>${html}</p>`;
            }


            // 7. WRITE / PREVIEW TABS
            writeTabBtn.addEventListener('click', () => {
                writeTabBtn.classList.add('active');
                previewTabBtn.classList.remove('active');
                contentTextarea.style.display = 'block';
                contentPreview.classList.remove('active');
            });

            previewTabBtn.addEventListener('click', () => {
                previewTabBtn.classList.add('active');
                writeTabBtn.classList.remove('active');
                contentTextarea.style.display = 'none';
                contentPreview.innerHTML = renderMarkdown(contentTextarea.value);
                contentPreview.classList.add('active');
            });


            // 8. RESET BUTTON
            resetBtn.addEventListener('click', () => {
                if (confirm('Are you sure you want to clear all fields?')) {
                    document.getElementById('blogPostForm').reset();
                    clearThumbnailSelection();
                    updateTitleStats();
                    updateContentStats();
                    document.querySelectorAll('.suggestion-pill').forEach(p => p.classList.remove('active'));
                }
            });


            // 9. THEME TOGGLE
            function updateThemeButton() {
                const current = document.documentElement.getAttribute('data-theme') || 'dark';
                themeIcon.textContent = current === 'light' ? '☀️' : '🌙';
            }

            updateThemeButton();

            themeToggleBtn.addEventListener('click', () => {
                const current = document.documentElement.getAttribute('data-theme') || 'dark';
                const nextTheme = current === 'light' ? 'dark' : 'light';
                document.documentElement.setAttribute('data-theme', nextTheme);
                try {
                    localStorage.setItem('inkora_theme', nextTheme);
                } catch (e) {}
                updateThemeButton();
            });

        });
    </script>

</body>
</html>
