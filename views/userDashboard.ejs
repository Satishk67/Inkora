<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <%- include("./partials/style.ejs") %>

    <title><%= locals.author ? `${author}'s Dashboard | INKORA` : 'Dashboard | INKORA' %></title>
    <meta name="description" content="View stories and dashboard for authors on INKORA.">

    <style>
        .dashboard-page {
            min-height: 80vh;
            padding: 40px 8% 80px;
            position: relative;
            z-index: 1;
        }

        .dashboard-shell {
            display: grid;
            grid-template-columns: 280px 1fr;
            gap: 40px;
            align-items: start;
        }

        /* SIDEBAR / PROFILE CARD */
        .dashboard-sidebar {
            background: var(--bg-glass);
            backdrop-filter: blur(24px);
            -webkit-backdrop-filter: blur(24px);
            border: 1px solid var(--border-subtle);
            border-radius: var(--card-radius);
            padding: 32px 24px;
            position: sticky;
            top: 100px;
            display: flex;
            flex-direction: column;
            align-items: center;
            text-align: center;
            box-shadow: var(--card-shadow);
        }

        .sidebar-badge {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            background: var(--hero-tag-bg);
            color: var(--accent-tertiary);
            border: 1px solid var(--hero-tag-border);
            padding: 6px 14px;
            border-radius: 20px;
            font-size: 11px;
            font-weight: 700;
            letter-spacing: 1px;
            text-transform: uppercase;
            margin-bottom: 24px;
        }

        .avatar-container {
            width: 90px;
            height: 90px;
            border-radius: 50%;
            background: var(--gradient-primary);
            display: flex;
            align-items: center;
            justify-content: center;
            font-family: var(--font-heading);
            font-size: 2.2rem;
            font-weight: 700;
            color: white;
            margin-bottom: 18px;
            box-shadow: 0 8px 25px var(--accent-glow);
            text-transform: uppercase;
            border: 3px solid rgba(255, 255, 255, 0.1);
        }

        .author-title {
            font-family: var(--font-heading);
            font-size: 1.6rem;
            font-weight: 700;
            color: var(--text-primary);
            word-break: break-all;
            margin-bottom: 6px;
            line-height: 1.2;
        }

        .author-handle {
            color: var(--text-secondary);
            font-size: 0.9rem;
            margin-bottom: 20px;
        }

        .author-stats {
            width: 100%;
            border-top: 1px solid var(--border-subtle);
            border-bottom: 1px solid var(--border-subtle);
            padding: 16px 0;
            margin-bottom: 24px;
            display: flex;
            justify-content: center;
            gap: 20px;
        }

        .stat-item {
            display: flex;
            flex-direction: column;
            align-items: center;
        }

        .stat-val {
            font-family: var(--font-heading);
            font-size: 1.4rem;
            font-weight: 700;
            color: var(--text-primary);
        }

        .stat-lbl {
            font-size: 11px;
            color: var(--text-muted);
            text-transform: uppercase;
            font-weight: 600;
            letter-spacing: 0.5px;
        }

        .sidebar-actions {
            width: 100%;
            display: flex;
            flex-direction: column;
            gap: 12px;
        }

        .action-btn {
            width: 100%;
            padding: 12px 20px;
            border-radius: var(--btn-radius);
            font-size: 14px;
            font-weight: 600;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            transition: var(--transition-smooth);
            cursor: pointer;
            border: none;
            font-family: inherit;
        }

        .action-btn-primary {
            background: var(--gradient-primary);
            color: white;
            box-shadow: 0 4px 15px var(--accent-glow);
        }

        .action-btn-primary:hover {
            transform: translateY(-2px);
            box-shadow: 0 8px 25px var(--accent-glow);
        }

        .action-btn-secondary {
            background: var(--bg-card);
            border: 1px solid var(--border-subtle);
            color: var(--text-primary);
        }

        .action-btn-secondary:hover {
            background: var(--bg-glass-hover);
            border-color: var(--border-accent);
            transform: translateY(-2px);
        }

        /* MAIN CONTENT AREA */
        .dashboard-main {
            display: flex;
            flex-direction: column;
            gap: 28px;
        }

        .dashboard-section-title {
            font-family: var(--font-heading);
            font-size: 1.8rem;
            font-weight: 700;
            color: var(--text-primary);
            position: relative;
            padding-bottom: 8px;
        }

        .dashboard-section-title::after {
            content: '';
            position: absolute;
            bottom: 0;
            left: 0;
            width: 40px;
            height: 3px;
            background: var(--gradient-primary);
            border-radius: 2px;
        }

        .blog-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
            gap: 28px;
            width: 100%;
        }

        /* MINI CARD STYLING Override (matching blogPage.ejs) */
        .mini-card {
            background: var(--bg-glass);
            backdrop-filter: blur(16px);
            -webkit-backdrop-filter: blur(16px);
            border: 1px solid var(--border-subtle);
            border-radius: var(--card-radius);
            overflow: hidden;
            transition: var(--transition-spring);
            display: flex;
            flex-direction: column;
            position: relative;
        }

        .mini-card:hover {
            transform: translateY(-6px);
            border-color: var(--border-accent);
            box-shadow: var(--card-shadow);
        }

        .mini-card-link {
            display: flex;
            flex-direction: column;
            height: 100%;
            color: inherit;
            text-decoration: none;
        }

        .mini-card-cover {
            height: 180px;
            position: relative;
            background: var(--bg-card);
            overflow: hidden;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .mini-card-img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            transition: transform var(--transition-smooth);
        }

        .mini-card:hover .mini-card-img {
            transform: scale(1.05);
        }

        .mini-card-badge {
            position: absolute;
            top: 14px;
            left: 14px;
            background: rgba(10, 10, 15, 0.75);
            backdrop-filter: blur(10px);
            -webkit-backdrop-filter: blur(10px);
            border: 1px solid var(--border-subtle);
            color: var(--accent-tertiary);
            font-size: 11px;
            font-weight: 700;
            letter-spacing: 0.8px;
            text-transform: uppercase;
            padding: 4px 10px;
            border-radius: 12px;
        }

        .mini-card-body {
            padding: 22px;
            display: flex;
            flex-direction: column;
            flex: 1;
            justify-content: space-between;
        }

        .mini-card-title {
            font-family: var(--font-heading);
            font-size: 1.18rem;
            font-weight: 600;
            line-height: 1.4;
            color: var(--text-primary);
            margin-bottom: 10px;
            display: -webkit-box;
            -webkit-line-clamp: 2;
            -webkit-box-orient: vertical;
            overflow: hidden;
            transition: color var(--transition-fast);
        }

        .mini-card:hover .mini-card-title {
            color: var(--accent-tertiary);
        }

        .mini-card-excerpt {
            color: var(--text-secondary);
            font-size: 13.5px;
            line-height: 1.6;
            margin-bottom: 20px;
            display: -webkit-box;
            -webkit-line-clamp: 3;
            -webkit-box-orient: vertical;
            overflow: hidden;
        }

        .mini-card-footer {
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding-top: 10px;
            border-top: 1px solid var(--border-subtle);
            margin-top: auto;
        }

        .author-block {
            display: flex;
            align-items: center;
            gap: 9px;
        }

        .author-meta {
            display: flex;
            flex-direction: column;
        }

        .author-name {
            font-size: 12.5px;
            font-weight: 600;
            color: var(--text-primary);
        }

        .post-date {
            font-size: 11px;
            color: var(--text-muted);
        }

        .reading-time {
            font-size: 11.5px;
            color: var(--text-muted);
            font-weight: 500;
        }

        /* EMPTY STATE */
        .empty-state {
            grid-column: 1 / -1;
            background: var(--bg-glass);
            border: 1px dashed var(--border-subtle);
            border-radius: var(--card-radius);
            padding: 60px 24px;
            text-align: center;
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 16px;
            backdrop-filter: blur(16px);
            -webkit-backdrop-filter: blur(16px);
        }

        .empty-icon {
            font-size: 48px;
            margin-bottom: 8px;
            filter: drop-shadow(0 4px 10px var(--accent-glow));
        }

        .empty-state h3 {
            font-family: var(--font-heading);
            font-size: 1.6rem;
            color: var(--text-primary);
        }

        .empty-state p {
            color: var(--text-secondary);
            font-size: 15px;
            max-width: 440px;
            margin-bottom: 8px;
            line-height: 1.6;
        }

        /* NOT FOUND / ERROR STATE */
        .not-found-container {
            min-height: 70vh;
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            text-align: center;
            padding: 40px 24px;
            position: relative;
            z-index: 1;
        }

        .not-found-card {
            background: var(--bg-glass);
            backdrop-filter: blur(24px);
            -webkit-backdrop-filter: blur(24px);
            border: 1px solid var(--border-subtle);
            border-radius: var(--card-radius);
            padding: 50px 40px;
            max-width: 500px;
            width: 100%;
            box-shadow: var(--card-shadow);
            position: relative;
            overflow: hidden;
            display: flex;
            flex-direction: column;
            align-items: center;
        }

        .not-found-card::before {
            content: '';
            position: absolute;
            top: 0; left: 0; right: 0;
            height: 4px;
            background: var(--gradient-primary);
        }

        .not-found-icon {
            font-size: 64px;
            margin-bottom: 24px;
            filter: drop-shadow(0 8px 15px rgba(244, 63, 94, 0.3));
        }

        .not-found-title {
            font-family: var(--font-heading);
            font-size: 2rem;
            font-weight: 700;
            color: var(--text-primary);
            margin-bottom: 14px;
        }

        .not-found-desc {
            color: var(--text-secondary);
            font-size: 15px;
            line-height: 1.6;
            margin-bottom: 30px;
        }

        .back-home-btn {
            background: var(--gradient-primary);
            color: white;
            padding: 12px 28px;
            border-radius: var(--btn-radius);
            font-size: 15px;
            font-weight: 600;
            box-shadow: 0 4px 15px var(--accent-glow);
            transition: var(--transition-smooth);
            text-decoration: none;
            display: inline-flex;
            align-items: center;
            gap: 8px;
        }

        .back-home-btn:hover {
            transform: translateY(-2px);
            box-shadow: 0 8px 25px var(--accent-glow);
        }

        /* MEDIA QUERIES */
        @media (max-width: 900px) {
            .dashboard-shell {
                grid-template-columns: 1fr;
                gap: 30px;
            }

            .dashboard-sidebar {
                position: relative;
                top: 0;
                width: 100%;
                box-sizing: border-box;
            }
        }

        @media (max-width: 600px) {
            .dashboard-page {
                padding: 30px 5% 60px;
            }

            .not-found-card {
                padding: 40px 20px;
            }
        }
    </style>
</head>

<body>

    <!-- FLOATING ORBS -->
    <div class="orb orb-1"></div>
    <div class="orb orb-2"></div>

    <%- include("./partials/navbar.ejs") %>

    <% if (status === "false") { %>
        <div class="not-found-container">
            <div class="not-found-card">
                <div class="not-found-icon">🕵️‍♂️</div>
                <h1 class="not-found-title">Author Not Found</h1>
                <p class="not-found-desc">
                    We couldn't find any author with that username. They may have changed their username or deleted their account.
                </p>
                <a href="/" class="back-home-btn">
                    <span>🏠</span> Return Home
                </a>
            </div>
        </div>
    <% } else { %>
        <main class="dashboard-page">
            <div class="dashboard-shell">
                <!-- SIDEBAR -->
                <aside class="dashboard-sidebar">
                    <div class="sidebar-badge">Author</div>
                    
                    <div class="account-btn" style="width: 90px; height: 90px;">
                        <img src="<%= authorPic %>" alt="Profilepic" class="profilepic"/>
                    </div>

                    <h1 class="author-title">
                        <%= author %>
                    </h1> 
                    <span class="author-handle">@<%= author %></span>

                    <div class="author-stats">
                        <div class="stat-item">
                            <span class="stat-val"><%= blogs ? blogs.length : 0 %></span>
                            <span class="stat-lbl">Stories</span>
                        </div>
                    </div>

                    <div class="sidebar-actions">
                        <% if (user && user.userName === author) { %>
                            <a href="/blogs/create" class="action-btn action-btn-primary">
                                <span>✍️</span> Write a Story
                            </a>
                        <% } %>
                        <button class="action-btn action-btn-secondary" onclick="shareProfile(this)">
                            <span>🔗</span> Share Profile
                        </button>
                    </div>
                </aside>

                <!-- MAIN WORKSPACE -->
                <section class="dashboard-main">
                    <h2 class="dashboard-section-title">Published Stories</h2>

                    <div class="blog-grid">
                        <% if (blogs && blogs.length) { %>
                            <% blogs.forEach(function(blog) { %>
                                <%- include("./partials/card.ejs", { blog: blog }) %>
                            <% }); %>
                        <% } else { %>
                            <div class="empty-state">
                                <div class="empty-icon">✍️</div>
                                <h3>No stories yet</h3>
                                <p>This author has not published any stories on Inkora.</p>
                                <% if (user && user.userName === author) { %>
                                    <a href="/blogs/create" class="back-home-btn" style="margin-top: 8px;">
                                        <span>✨</span> Write Your First Story
                                    </a>
                                <% } %>
                            </div>
                        <% } %>
                    </div>
                </section>
            </div>
        </main>
    <% } %>

    <%- include("./partials/footer.ejs") %>
    <%- include("./partials/script.ejs") %>

    <script>
        function shareProfile(btn) {
            navigator.clipboard.writeText(window.location.href);
            const originalText = btn.innerHTML;
            btn.innerHTML = '<span>✓</span> Copied Link!';
            btn.style.borderColor = 'var(--accent-secondary)';
            btn.style.color = 'var(--accent-tertiary)';
            setTimeout(() => {
                btn.innerHTML = originalText;
                btn.style.borderColor = '';
                btn.style.color = '';
            }, 2000);
        }
    </script>
</body>

</html>