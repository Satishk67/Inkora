<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Internal Server Error | INKORA</title>
    
    <%- include("./partials/style.ejs") %>

    <style>
        body {
            display: flex;
            justify-content: center;
            align-items: center;
            min-height: 100vh;
            padding: 24px;
            overflow-x: hidden;
            position: relative;
        }

        .error-container {
            width: 100%;
            max-width: 580px;
            z-index: 1;
        }

        .error-card {
            background: var(--bg-glass);
            backdrop-filter: blur(24px);
            -webkit-backdrop-filter: blur(24px);
            border: 1px solid var(--border-subtle);
            border-radius: var(--card-radius);
            padding: 50px 40px;
            text-align: center;
            box-shadow: var(--card-shadow);
            position: relative;
            overflow: hidden;
            animation: scaleIn 0.5s cubic-bezier(0.34, 1.56, 0.64, 1) both;
            display: flex;
            flex-direction: column;
            align-items: center;
        }

        .error-card::before {
            content: '';
            position: absolute;
            top: 0; left: 0; right: 0;
            height: 4px;
            background: linear-gradient(90deg, #f43f5e, #fb7185);
        }

        /* NEON ERROR ICON */
        .error-visual {
            position: relative;
            width: 120px;
            height: 120px;
            margin-bottom: 30px;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .error-icon-glow {
            position: absolute;
            width: 100px;
            height: 100px;
            border-radius: 50%;
            background: rgba(244, 63, 94, 0.15);
            filter: blur(20px);
            animation: pulse 2.5s infinite ease-in-out;
        }

        .error-svg {
            width: 80px;
            height: 80px;
            filter: drop-shadow(0 4px 12px rgba(244, 63, 94, 0.4));
            stroke: #f43f5e;
            stroke-width: 1.5;
            fill: none;
            stroke-linecap: round;
            stroke-linejoin: round;
        }

        .error-code {
            font-family: var(--font-heading);
            font-size: 1.2rem;
            font-weight: 800;
            color: #f43f5e;
            text-transform: uppercase;
            letter-spacing: 2px;
            margin-bottom: 8px;
        }

        .error-title {
            font-family: var(--font-heading);
            font-size: 2rem;
            font-weight: 700;
            line-height: 1.2;
            color: var(--text-primary);
            margin-bottom: 14px;
        }

        .error-desc {
            color: var(--text-secondary);
            font-size: 15px;
            line-height: 1.6;
            margin-bottom: 32px;
        }

        /* COLLAPSIBLE DETAILS BOX */
        .technical-details {
            width: 100%;
            margin-bottom: 36px;
            text-align: left;
        }

        .details-summary {
            font-family: var(--font-body);
            font-size: 13px;
            font-weight: 600;
            color: var(--text-muted);
            cursor: pointer;
            padding: 8px 12px;
            border-radius: 8px;
            background: var(--bg-card);
            border: 1px solid var(--border-subtle);
            display: inline-flex;
            align-items: center;
            gap: 6px;
            user-select: none;
            transition: var(--transition-fast);
        }

        .details-summary:hover {
            color: var(--text-secondary);
            background: var(--bg-glass-hover);
        }

        .error-console {
            margin-top: 12px;
            background: rgba(10, 10, 15, 0.9);
            border: 1px solid rgba(244, 63, 94, 0.25);
            border-radius: 12px;
            padding: 16px;
            font-family: 'Courier New', Courier, monospace;
            font-size: 13px;
            color: #fda4af;
            overflow-x: auto;
            white-space: pre-wrap;
            word-break: break-all;
            box-shadow: inset 0 2px 8px rgba(0, 0, 0, 0.8);
            max-height: 150px;
        }

        /* ACTION BUTTONS */
        .action-group {
            display: flex;
            flex-wrap: wrap;
            gap: 16px;
            justify-content: center;
            width: 100%;
        }

        .btn {
            padding: 12px 26px;
            border-radius: var(--btn-radius);
            font-size: 14.5px;
            font-weight: 600;
            display: inline-flex;
            align-items: center;
            gap: 8px;
            transition: var(--transition-smooth);
            cursor: pointer;
            text-decoration: none;
            font-family: inherit;
            border: none;
        }

        .btn-danger {
            background: linear-gradient(135deg, #f43f5e, #e11d48);
            color: white;
            box-shadow: 0 4px 15px rgba(244, 63, 94, 0.35);
        }

        .btn-danger:hover {
            transform: translateY(-2px);
            box-shadow: 0 8px 25px rgba(244, 63, 94, 0.45);
        }

        .btn-outline {
            background: var(--bg-card);
            border: 1px solid var(--border-subtle);
            color: var(--text-primary);
        }

        .btn-outline:hover {
            background: var(--bg-glass-hover);
            border-color: var(--border-accent);
            transform: translateY(-2px);
        }

        @keyframes pulse {
            0%, 100% {
                transform: scale(0.95);
                opacity: 0.5;
            }
            50% {
                transform: scale(1.1);
                opacity: 0.8;
            }
        }

        @media (max-width: 600px) {
            .error-card {
                padding: 40px 20px;
            }

            .action-group {
                flex-direction: column;
                width: 100%;
            }

            .btn {
                width: 100%;
                justify-content: center;
            }
        }
    </style>
</head>
<body>

    <!-- FLOATING ORBS -->
    <div class="orb orb-1" style="background: rgba(244, 63, 94, 0.08); top: -100px; left: -100px; width: 400px; height: 400px;"></div>
    <div class="orb orb-2" style="background: rgba(124, 58, 237, 0.08); bottom: -100px; right: -100px; width: 450px; height: 450px;"></div>

    <div class="error-container">
        <div class="error-card">
            
            <div class="error-visual">
                <div class="error-icon-glow"></div>
                <svg class="error-svg" viewBox="0 0 24 24">
                    <path d="M12 9v4M12 17h.01M10.29 3.86L1.82 18a2 2 0 001.71 3h16.94a2 2 0 001.71-3L13.71 3.86a2 2 0 00-3.42 0z"/>
                </svg>
            </div>

            <div class="error-code">Status 500</div>
            <h1 class="error-title">Something went wrong</h1>
            <p class="error-desc">
                Inkora encountered an unexpected issue while processing your request. Our servers might be undergoing maintenance, or a minor glitch occurred.
            </p>

            <% if (locals.msg) { %>
                <div class="technical-details">
                    <details>
                        <summary class="details-summary">
                            <span>🛠️</span> Technical Details
                        </summary>
                        <pre class="error-console"><%= msg %></pre>
                    </details>
                </div>
            <% } %>

            <div class="action-group">
                <button onclick="window.location.reload()" class="btn btn-danger">
                    <span>🔄</span> Reload Page
                </button>
                <a href="/" class="btn btn-outline">
                    <span>🏠</span> Go to Home
                </a>
                <a href="/blogs" class="btn btn-outline">
                    <span>🧭</span> Explore Stories
                </a>
            </div>

        </div>
    </div>

</body>
</html>