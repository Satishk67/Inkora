<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>INKORA — Where Ideas Find Their Voice</title>

    <%- include("./partials/style.ejs") %>

</head>


<body>

    <%- include("./partials/navbar.ejs") %>


<!--HERO SECTION-->

<section class="hero" id="home">

    <div class="hero-content">

        <div class="hero-tag">
            ✨ A new home for curious minds
        </div>


        <h1>
            Where ideas
            <br>
            find their
            <span>voice.</span>
        </h1>


        <p>
            Discover stories, ideas and perspectives
            from people who have something meaningful
            to say.
        </p>


        <div class="hero-buttons">

            <button class="primary-btn">
                Start Reading →
            </button>

            <button class="secondary-btn">
                ✍ Start Writing
            </button>

        </div>


        <div class="stats">

            <div class="stat">

                <h3>25K+</h3>

                <p>Stories Published</p>

            </div>


            <div class="stat">

                <h3>8K+</h3>

                <p>Active Writers</p>

            </div>


            <div class="stat">

                <h3>120K+</h3>

                <p>Readers</p>

            </div>

        </div>

    </div>



    <!-- HERO ARTICLE CARD -->

    <div class="hero-visual">

        <div class="hero-card">

            <span class="article-label">
                Featured Story
            </span>


            <h2>
                The art of slowing down
                in a world that never stops.
            </h2>


            <div class="author-info">

                <div class="avatar"></div>

                <div>

                    <strong>Emma Carter</strong>

                    <br>

                    <small>
                        6 min read
                    </small>

                </div>

            </div>

        </div>

    </div>

</section>



<!-- FEATURED ARTICLES-->

<section
    class="section"
    id="featured"
>

    <div class="section-header">

        <h2>
            Featured Stories
        </h2>

        <a href="#" class="view-all">
            View all →
        </a>

    </div>


    <div class="articles-grid">


        <!-- ARTICLE 1 -->

        <article class="article-card">

            <div class="article-image image-1">
                💡
            </div>


            <div class="article-content">

                <span class="category">
                    TECHNOLOGY
                </span>


                <h3>
                    How AI is quietly changing the way we create
                </h3>


                <p>
                    Exploring the relationship between
                    creativity and artificial intelligence.
                </p>


                <div class="article-meta">

                    <span>
                        Alex Morgan
                    </span>

                    <span>
                        5 min read
                    </span>

                </div>

            </div>

        </article>



        <!-- ARTICLE 2 -->

        <article class="article-card">

            <div class="article-image image-2">
                🌱
            </div>


            <div class="article-content">

                <span class="category">
                    LIFESTYLE
                </span>


                <h3>
                    Small habits that can completely change your life
                </h3>


                <p>
                    Tiny decisions repeated every day
                    can create massive results.
                </p>


                <div class="article-meta">

                    <span>
                        Sarah Wilson
                    </span>

                    <span>
                        4 min read
                    </span>

                </div>

            </div>

        </article>



        <!-- ARTICLE 3 -->

        <article class="article-card">

            <div class="article-image image-3">
                🚀
            </div>


            <div class="article-content">

                <span class="category">
                    STARTUPS
                </span>


                <h3>
                    Why most great ideas start as terrible ones
                </h3>


                <p>
                    The messy reality behind building
                    something people actually love.
                </p>


                <div class="article-meta">

                    <span>
                        Daniel Lee
                    </span>

                    <span>
                        7 min read
                    </span>

                </div>

            </div>

        </article>


    </div>

</section>



<!-- =========================
     TRENDING TOPICS
========================== -->

<section
    class="section trending"
    id="trending"
>

    <h2>
        Trending Topics
    </h2>


    <div class="topics">

        <div class="topic">
            🚀 Startups
        </div>

        <div class="topic">
            🤖 Artificial Intelligence
        </div>

        <div class="topic">
            💻 Programming
        </div>

        <div class="topic">
            📚 Productivity
        </div>

        <div class="topic">
            🎨 Design
        </div>

        <div class="topic">
            🌍 Travel
        </div>

        <div class="topic">
            🧠 Psychology
        </div>

        <div class="topic">
            💰 Finance
        </div>

    </div>

</section>



<!-- =========================
     NEWSLETTER
========================== -->

<section class="newsletter">

    <h2>
        Stories worth your time.
    </h2>


    <p>
        Get the best stories from INKORA
        delivered directly to your inbox.
    </p>


    <form
        class="newsletter-form"
        id="newsletterForm"
    >

        <input
            type="email"
            placeholder="Enter your email"
            required
        >

        <button type="submit">
            Subscribe
        </button>

    </form>

</section>



<!-- =========================
     FOOTER
========================== -->

<footer id="about">

    <div>

        <div class="logo">
            <div class="logo-icon">
                I
            </div>

            INKORA
        </div>


        <p style="margin-top: 10px;">
            Where ideas find their voice.
        </p>

    </div>


    <p>
        © 2026 INKORA. Built for thinkers and storytellers.
    </p>

</footer>



<!-- =========================
     SEARCH MODAL
========================== -->

<div
    class="search-modal"
    id="searchModal"
>

    <div class="search-box">

        <input
            type="text"
            id="searchInput"
            placeholder="Search stories, writers or topics..."
        >

    </div>

</div>
    <%- include('./partials/script.ejs') %>
</body>
</html>