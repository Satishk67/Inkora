<!DOCTYPE html>
<html lang="en">
<head>

    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <title>Sign Up | INKORA</title>


    <style>

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }


        body {

            font-family: Arial, Helvetica, sans-serif;

            min-height: 100vh;

            background:
                radial-gradient(circle at top right, #e5e3ff, transparent 35%),
                radial-gradient(circle at bottom left, #ffe0e8, transparent 35%),
                #f7f7f7;

            padding: 30px;

            display: flex;
            justify-content: center;
            align-items: center;

        }


        .container {

            width: 100%;
            max-width: 1100px;

            background: white;

            display: grid;
            grid-template-columns: 0.9fr 1.1fr;

            border-radius: 25px;

            overflow: hidden;

            box-shadow:
                0 25px 60px rgba(0,0,0,0.12);

        }


        /* LEFT */

        .branding {

            background: #171717;

            color: white;

            padding: 60px;

            display: flex;
            flex-direction: column;
            justify-content: space-between;

        }


        .logo {

            display: flex;
            align-items: center;

            gap: 10px;

            font-size: 25px;
            font-weight: bold;

            letter-spacing: 2px;

        }


        .logo-icon {

            width: 42px;
            height: 42px;

            display: flex;
            justify-content: center;
            align-items: center;

            border-radius: 12px;

            background:
                linear-gradient(
                    135deg,
                    #6c63ff,
                    #ff6584
                );

        }


        .branding h1 {

            font-size: 50px;

            line-height: 1.1;

        }


        .branding h1 span {

            color: #8d87ff;

        }


        .branding p {

            color: #aaa;

            margin-top: 20px;

            line-height: 1.7;

        }


        .benefits {

            list-style: none;

            display: flex;
            flex-direction: column;

            gap: 15px;

            color: #ccc;

        }


        /* FORM */

        .form-section {

            padding: 50px;

        }


        .form-section h2 {

            font-size: 32px;

            margin-bottom: 8px;

        }


        .subtitle-msg {

            color: red;

            margin-bottom: 30px;

        }


        .form-grid {

            display: grid;

            grid-template-columns: 1fr 1fr;

            gap: 18px;

        }


        .input-group {

            margin-bottom: 18px;

        }


        .input-group.full {

            grid-column: span 2;

        }


        label {

            display: block;

            margin-bottom: 8px;

            font-size: 14px;

            font-weight: bold;

        }


        input,
        select {

            width: 100%;

            padding: 14px;

            border:
                1px solid #ddd;

            border-radius: 10px;

            outline: none;

            font-size: 14px;

            transition: 0.3s;

        }


        input:focus,
        select:focus {

            border-color: #6c63ff;

            box-shadow:
                0 0 0 3px
                rgba(108,99,255,0.1);

        }


        .profile-upload {

            display: flex;

            align-items: center;

            gap: 20px;

            margin-bottom: 25px;

        }


        .profile-preview {

            width: 70px;
            height: 70px;

            border-radius: 50%;

            background: #f0f0f0;

            display: flex;

            justify-content: center;
            align-items: center;

            font-size: 28px;

            overflow: hidden;

        }


        .profile-preview img {

            width: 100%;
            height: 100%;

            object-fit: cover;

        }


        .upload-btn {

            display: inline-block;

            padding: 10px 16px;

            background: #f2f2f2;

            border-radius: 8px;

            font-size: 13px;

            cursor: pointer;

        }


        .upload-btn:hover {

            background: #e5e5e5;

        }


        .terms {

            display: flex;

            gap: 8px;

            align-items: flex-start;

            font-size: 13px;

            color: #666;

            margin-bottom: 22px;

        }


        .terms input {

            width: auto;

            margin-top: 3px;

        }


        .terms a {

            color: #6c63ff;

            font-weight: bold;

        }


        .signup-btn {

            width: 100%;

            padding: 15px;

            border-radius: 10px;

            background: #171717;

            color: white;

            font-size: 16px;

            font-weight: bold;

            transition: 0.3s;

        }


        .signup-btn:hover {

            background: #333;

            transform: translateY(-2px);

        }


        .login-text {

            text-align: center;

            margin-top: 25px;

            color: #777;

        }


        .login-text a {

            color: #6c63ff;

            font-weight: bold;

        }


        @media (max-width: 850px) {

            .container {

                grid-template-columns: 1fr;

            }


            .branding {

                display: none;

            }

        }


        @media (max-width: 550px) {

            body {

                padding: 10px;

            }


            .form-section {

                padding: 35px 20px;

            }


            .form-grid {

                grid-template-columns: 1fr;

            }


            .input-group.full {

                grid-column: span 1;

            }

        }
        .backend-msg {
            font-weight: lighter;
            font-size: x-small;
            font-weight: 500;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            animation: all ease-in-out 0.2;
        }
        .input-wrapper {
            position: relative;
        }
        .password-toggle {
            border: none;
            position: absolute;

            right: 15px;
            top: 50%;

            transform: translateY(-50%);

            background: transparent;

            font-size: 18px;
        }

        .password-toggle img {
            width: 25px;
            height: 25px;
        }

    </style>

</head>


<body>


<div class="container">


    <!-- BRANDING SECTION -->

    <section class="branding">


        <div class="logo">

            <div class="logo-icon">
                I
            </div>

            INKORA

        </div>


        <div>

            <h1>

                Start your
                <br>

                <span>
                    story.
                </span>

            </h1>


            <p>

                Join a community of writers,
                thinkers and curious minds sharing
                ideas with the world.

            </p>

        </div>


        <ul class="benefits">

            <li>
                ✍ Publish your stories
            </li>

            <li>
                🌍 Reach curious readers
            </li>

            <li>
                💡 Discover new ideas
            </li>

        </ul>


    </section>



    <!-- SIGNUP FORM -->

    <section class="form-section">


        <h2>
            Create your account 🚀
        </h2>

        <% if (locals.msg) { %>
            <p class=" subtitle-msg">
                <%= locals.msg %>
            </p>
        <% } %>


        <form
            id="signupForm"
            action="/user/signup" 
            method="POST"
        >


            <!-- PROFILE IMAGE -->

            <div class="profile-upload">


                <div
                    class="profile-preview"
                    id="profilePreview"
                >
                    👤
                </div>


                <div>

                    <label
                        for="profilePicture"
                        class="upload-btn"
                    >

                        Upload profile picture

                    </label>


                    <input
                        type="file"
                        id="profilePicture"
                        name="profilePicture"
                        accept="image/*"
                        hidden
                    >

                </div>

            </div>



            <div class="form-grid">


                <!-- FULL NAME -->

                <div class="input-group">

                    <label>
                        Full Name
                    </label>

                    <input
                        type="text"
                        id="fullName"
                        name="fullName"
                        placeholder="Rohit Kumar"
                        required
                    >

                </div>



                <!-- USERNAME -->

                <div class="input-group">

                    <label>
                        Username <span id="usernameMsg" class="backend-msg"></span>
                    </label>

                    <input
                        type="text"
                        id="userName"
                        name="userName"
                        placeholder="dynamic578"
                        required
                    >

                </div>



                <!-- EMAIL -->

                <div
                    class="input-group full"
                >

                    <label>
                        Email Address <span id="emailMsg" class="backend-msg"></span>
                    </label>

                    <input
                        type="email"
                        id="email"
                        name="email"
                        placeholder="john@example.com"
                        required
                    >

                </div>



                <!-- GENDER -->

                <div class="input-group">

                    <label>
                        Gender
                    </label>

                    <select
                        id="gender"
                        name="gender"
                        required
                    >

                        <option value="">
                            Select gender
                        </option>

                        <option value="Male">
                            Male
                        </option>

                        <option value="Female">
                            Female
                        </option>

                        <option value="Other">
                            Other
                        </option>

                    </select>

                </div>



                <!-- PASSWORD -->

                <div class="input-group">

                    <label>
                        Password
                        <span id="passwordMsg" class="backend-msg"></span>
                    </label>

                    <div class="input-wrapper">
                    <input
                        type="password"
                        id="password"
                        name="password"
                        placeholder="Create password"
                        required
                    >
                    <button
                        type="button"
                        class="password-toggle"
                        onclick="togglePassword()"
                    >
                        <img src="/logos/hide.svg" alt="Hidden/Shown" 
                        id="passwordLogo">
                    </button>
                    </div>

                </div>

            </div>


            <!-- SIGNUP -->

            <button
                type="submit"
                class="signup-btn"
            >

                Create INKORA Account →

            </button>


        </form>



        <p class="login-text">

            Already have an account?

            <a href="login">
                Log in
            </a>

        </p>


    </section>


</div>

<script>
    const passwordLogo = document.getElementById("passwordLogo");
    const userName = document.getElementById("userName");
    const userNameMsg = document.getElementById("usernameMsg");
    const password = document.getElementById("password");
    const passwordMsg = document.getElementById("passwordMsg");

    let checkuserName;

    function isValid(input,msgBox){
        if(input  == ""){
            msgBox.textContent = "Fill me !!";
            msgBox.style.color = "red";
            return false;
        }

        if(input.includes(" ")){
            msgBox.textContent = "Spaces are not allowed!";
            msgBox.style.color = "red";
            return false;
        }

        if(!(/\d/.test(input))){
            msgBox.textContent = "Must have atleast one numeric value!";
            msgBox.style.color = "red";
            return false;
        }

        if(input.length > 15 || input.length < 8){
            msgBox.textContent = "length must be within 8-15 range!";
            msgBox.style.color = "red";
            return false;
        }

        msgBox.textContent = "Kudos! Good to go";
        msgBox.style.color = "green";
        return true;
    }

    userName.addEventListener("input", (e) => {

        clearTimeout(checkuserName)
        const input = e.target.value.trim();

        if(!isValid(input,userNameMsg)) return ;
        
        checkuserName = setTimeout(async () => {
            const response = await fetch(`/user/checkuser/${input}`);
            const res = await response.json();
            userNameMsg.textContent = res.msg;
            userNameMsg.style.color = res.color;
        },1000);
    });

    password.addEventListener("input", (e) => {
        const input = e.target.value.trim();
        isValid(input,passwordMsg)
    });

    function togglePassword() {

        const password =
            document.getElementById("password");

        if (password.type === "password") {
            passwordLogo.src = "/logos/show.svg";
            password.type = "text";

        } else {
            passwordLogo.src = "/logos/hide.svg";
            password.type = "password";
        }

    }

</script>


</body>
</html>