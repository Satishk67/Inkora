<%
    // Helper function to extract plain text preview from markdown
    function getSnippet(content, maxLen) {
        if (!content) return '';
        var plain = content
            .replace(/```[\s\S]*?```/g, '')
            .replace(/`([^`]+)`/g, '$1')
            .replace(/[#*>`~_=-]/g, '')
            .replace(/\[([^\]]+)\]\([^)]+\)/g, '$1')
            .trim();
        return plain.length > maxLen ? plain.substring(0, maxLen) + '...' : plain;
    }

    // Helper for reading time
    function getReadingTime(content) {
        if (!content) return '1 min read';
        var words = content.trim().split(/\s+/).length;
        var minutes = Math.ceil(words / 200);
        return minutes + ' min read';
    }

    // Helper for date formatting
    function formatDate(dateString) {
        if (!dateString) return 'Recent';
        var d = new Date(dateString);
        return d.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' });
    }

    var snippet = getSnippet(blog.content, 110);
    var readTime = getReadingTime(blog.content);
    var dateStr = formatDate(blog.createdAt);
    var blogUrl = '/blogs/' + blog._id;
%>

<article class="mini-card" data-category="<%= (blog.category || '').toLowerCase() %>">
    <a href="<%= blogUrl %>" class="mini-card-link">
        
        <!-- THUMBNAIL / COVER -->
        <div class="mini-card-cover">
            
            <img 
                src="<%= blog.thumbnail %>" 
                alt="<%= blog.title %>" 
                class="mini-card-img" 
                loading="lazy" 
                onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';"
            >
        </div>

        <!-- CONTENT BODY -->
        <div class="mini-card-body">
            
            <div class="mini-card-header">
                <span class="mini-card-category">
                    <%= blog.category || 'General' %>
                </span>

                <% 
                    var isCreator = false;
                    if (locals.user && blog.createdBy) {
                        var creatorId = (blog.createdBy._id || blog.createdBy).toString();
                        if (locals.user._id === creatorId) {
                            isCreator = true;
                        }
                    }
                %>
                <% if (isCreator) { %>
                    <button class="card-delete-btn" onclick="window.deleteBlog('<%= blog._id %>', event)" title="Delete Story">
                        <svg viewBox="0 0 24 24" class="delete-icon" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                            <polyline points="3 6 5 6 21 6"></polyline>
                            <path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path>
                        </svg>
                    </button>
                <% } %>
            </div>

            <h3 class="mini-card-title">
                <%= blog.title %>
            </h3>

            <p class="mini-card-excerpt">
                <%= snippet %>
            </p>

            <!-- META / AUTHOR FOOTER -->
            <div class="mini-card-footer">
                <div class="author-block">
                    <div class="account-btn">
                    <img src="<%= blog.createdBy.profilePicture %>" alt="Profilepic" class="profilepic"/>
                </div>
                    <div class="author-meta">
                        <span class="author-name"><%= blog.author || 'Anonymous' %></span>
                        <span class="post-date"><%= dateStr %></span>
                    </div>
                </div>

                <div class="reading-time">
                    <span>📖 <%= readTime %></span>
                </div>
            </div>
        </div>

    </a>
</article>
