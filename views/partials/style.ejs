    <style>

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        html {
            scroll-behavior: smooth;
        }

        body {
            font-family: Arial, Helvetica, sans-serif;
            background: #f8f8f7;
            color: #171717;
            line-height: 1.6;
        }

        a {
            text-decoration: none;
            color: inherit;
        }

        button {
            border: none;
            cursor: pointer;
            font-family: inherit;
        }
  
        /* NAVBAR */
        

        .navbar {
            position: sticky;
            top: 0;
            z-index: 1000;

            display: flex;
            align-items: center;
            justify-content: space-between;

            padding: 18px 7%;
            background: rgba(255, 255, 255, 0.9);
            backdrop-filter: blur(15px);

            border-bottom: 1px solid #e8e8e8;
        }

        /* LOGO */

        .logo {
            font-size: 1.8rem;
            font-weight: 800;
            letter-spacing: 2px;
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .logo-icon {
            width: 35px;
            height: 35px;

            background: #171717;
            color: white;

            display: flex;
            justify-content: center;
            align-items: center;

            border-radius: 10px;
            font-size: 18px;
        }

        /* NAVIGATION LINKS */

        .nav-links {
            display: flex;
            gap: 30px;
            list-style: none;
        }

        .nav-links a {
            color: #555;
            font-size: 15px;
            font-weight: 500;
            transition: 0.3s;
        }

        .nav-links a:hover,
        .nav-links a.active {
            color: #000;
        }

        /* RIGHT SIDE NAV */

        .nav-actions {
            display: flex;
            align-items: center;
            gap: 15px;
        }

        .search-btn {
            background: transparent;
            font-size: 20px;
            padding: 8px;
            transition: 0.3s;
        }

        .search-btn:hover {
            transform: scale(1.15);
        }

        .login-btn {
            background: transparent;
            font-size: 15px;
            font-weight: 600;
            padding: 10px 16px;
        }

        .signup-btn {
            background: #171717;
            color: white;

            padding: 11px 20px;
            border-radius: 10px;

            font-weight: 600;
            transition: 0.3s;
        }

        .signup-btn:hover {
            background: #333;
            transform: translateY(-2px);
        }

        /* ACCOUNT */

        .account {
            position: relative;
        }

        .account-btn {
            width: 50px;
            height: 50px;

            border-radius: 50%;
            background-color: rgb(12, 9, 9);

            color: white;
            font-weight: bold;
            font-size: 16px;
            overflow: hidden;
        }

        .profilepic{
            width: 75%;
            height: 75%;
            object-fit: cover;
        }

        .account-menu {
            position: absolute;

            top: 55px;
            right: 0;

            width: 190px;

            background: white;

            border-radius: 14px;

            box-shadow: 0 15px 40px rgba(0,0,0,0.12);

            padding: 10px;

            display: none;
        }

        .account-menu.active {
            display: block;
            animation: fadeIn 0.25s ease;
        }

        .account-menu a {
            display: block;

            padding: 12px;

            border-radius: 8px;

            font-size: 14px;

            transition: 0.2s;
        }

        .account-menu a:hover {
            background: #f2f2f2;
        }

        /* HERO SECTION */

        .hero {
            min-height: 85vh;

            display: grid;
            grid-template-columns: 1.2fr 1fr;

            align-items: center;

            gap: 60px;

            padding: 80px 10%;
        }

        .hero-tag {
            display: inline-block;

            background: #ecebff;
            color: #5148d9;

            padding: 8px 15px;

            border-radius: 30px;

            font-size: 13px;
            font-weight: bold;

            margin-bottom: 20px;
        }

        .hero h1 {
            font-size: clamp(3rem, 6vw, 5.5rem);

            line-height: 1.05;

            margin-bottom: 25px;

            letter-spacing: -2px;
        }

        .hero h1 span {
            color: #6c63ff;
        }

        .hero p {
            color: #666;

            max-width: 550px;

            font-size: 18px;

            margin-bottom: 30px;
        }

        .hero-buttons {
            display: flex;
            gap: 15px;
            flex-wrap: wrap;
        }

        .primary-btn {
            background: #171717;
            color: white;

            padding: 15px 25px;

            border-radius: 12px;

            font-weight: bold;

            transition: 0.3s;
        }

        .primary-btn:hover {
            transform: translateY(-3px);
            box-shadow: 0 10px 25px rgba(0,0,0,0.15);
        }

        .secondary-btn {
            background: white;

            padding: 15px 25px;

            border-radius: 12px;

            border: 1px solid #ddd;

            font-weight: bold;

            transition: 0.3s;
        }

        .secondary-btn:hover {
            background: #f1f1f1;
        }

        /* HERO CARD */

        .hero-visual {
            position: relative;
        }

        .hero-card {
            background: #171717;

            color: white;

            padding: 40px;

            border-radius: 25px;

            min-height: 380px;

            display: flex;
            flex-direction: column;
            justify-content: space-between;

            transform: rotate(2deg);

            transition: 0.4s;
        }

        .hero-card:hover {
            transform: rotate(0deg) translateY(-8px);
        }

        .article-label {
            font-size: 13px;

            background: rgba(255,255,255,0.15);

            padding: 7px 12px;

            border-radius: 20px;

            width: fit-content;
        }

        .hero-card h2 {
            font-size: 2.2rem;
            line-height: 1.2;
        }

        .author-info {
            display: flex;
            align-items: center;
            gap: 12px;
        }

        .avatar {
            width: 42px;
            height: 42px;

            border-radius: 50%;

            background: linear-gradient(135deg, #ff6584, #6c63ff);
        }

        .author-info small {
            color: #aaa;
        }

       /* STATS */

        .stats {
            display: flex;
            gap: 45px;

            margin-top: 45px;
        }

        .stat h3 {
            font-size: 1.7rem;
        }

        .stat p {
            font-size: 13px;
            margin: 0;
        }

        /* FEATURED ARTICLES */

        .section {
            padding: 90px 10%;
        }

        .section-header {
            display: flex;
            justify-content: space-between;
            align-items: center;

            margin-bottom: 45px;
        }

        .section-header h2 {
            font-size: 2.5rem;
        }

        .view-all {
            color: #6c63ff;
            font-weight: bold;
        }

        .articles-grid {
            display: grid;

            grid-template-columns:
                repeat(auto-fit, minmax(260px, 1fr));

            gap: 25px;
        }

        .article-card {
            background: white;

            border-radius: 20px;

            overflow: hidden;

            border: 1px solid #eee;

            transition: 0.3s;
        }

        .article-card:hover {
            transform: translateY(-8px);

            box-shadow: 0 20px 40px rgba(0,0,0,0.08);
        }

        .article-image {
            height: 200px;

            display: flex;
            justify-content: center;
            align-items: center;

            font-size: 60px;
        }

        .image-1 {
            background: linear-gradient(135deg, #fbc2eb, #a6c1ee);
        }

        .image-2 {
            background: linear-gradient(135deg, #84fab0, #8fd3f4);
        }

        .image-3 {
            background: linear-gradient(135deg, #fccb90, #d57eeb);
        }

        .article-content {
            padding: 25px;
        }

        .category {
            color: #6c63ff;

            font-size: 13px;
            font-weight: bold;
        }

        .article-content h3 {
            margin: 12px 0;

            font-size: 1.3rem;

            line-height: 1.4;
        }

        .article-content p {
            color: #777;
            font-size: 14px;
        }

        .article-meta {
            display: flex;

            justify-content: space-between;

            margin-top: 20px;

            font-size: 12px;

            color: #999;
        }

       /* TRENDING SECTION */

        .trending {
            background: #171717;
            color: white;
        }

        .trending h2 {
            font-size: 2.5rem;
            margin-bottom: 40px;
        }

        .topics {
            display: flex;
            flex-wrap: wrap;
            gap: 15px;
        }

        .topic {
            padding: 15px 22px;

            border: 1px solid #444;

            border-radius: 40px;

            transition: 0.3s;

            cursor: pointer;
        }

        .topic:hover {
            background: white;
            color: black;
            transform: translateY(-3px);
        }

        /* NEWSLETTER */

        .newsletter {
            text-align: center;

            background: #ecebff;

            margin: 80px 10%;

            padding: 70px 20px;

            border-radius: 30px;
        }

        .newsletter h2 {
            font-size: 2.5rem;
            margin-bottom: 15px;
        }

        .newsletter p {
            color: #666;
            margin-bottom: 25px;
        }

        .newsletter-form {
            display: flex;

            max-width: 500px;

            margin: auto;

            gap: 10px;
        }

        .newsletter-form input {
            flex: 1;

            padding: 15px;

            border-radius: 10px;

            border: 1px solid #ddd;

            outline: none;
        }

        .newsletter-form button {
            background: #171717;
            color: white;

            padding: 15px 25px;

            border-radius: 10px;
        }

       /* FOOTER */

        footer {
            padding: 50px 10%;

            border-top: 1px solid #e5e5e5;

            display: flex;

            justify-content: space-between;

            flex-wrap: wrap;

            gap: 20px;
        }

        footer p {
            color: #777;
            font-size: 14px;
        }

        /* SEARCH MODAL */

        .search-modal {
            position: fixed;

            inset: 0;

            background: rgba(0,0,0,0.5);

            display: none;

            justify-content: center;
            align-items: flex-start;

            padding-top: 120px;

            z-index: 2000;
        }

        .search-modal.active {
            display: flex;
        }

        .search-box {
            width: min(600px, 90%);

            background: white;

            padding: 25px;

            border-radius: 20px;
        }

        .search-box input {
            width: 100%;

            padding: 18px;

            border: 1px solid #ddd;

            border-radius: 10px;

            font-size: 16px;

            outline: none;
        }

        /* MOBILE NAVIGATION */

        .menu-btn {
            display: none;

            background: transparent;

            font-size: 24px;
        }

        @media (max-width: 900px) {

            .hero {
                grid-template-columns: 1fr;
                text-align: center;
            }

            .hero p {
                margin-left: auto;
                margin-right: auto;
            }

            .hero-buttons,
            .stats {
                justify-content: center;
            }

            .hero-visual {
                max-width: 600px;
                margin: auto;
                width: 100%;
            }

            .nav-links {
                position: absolute;

                top: 75px;
                left: 0;

                width: 100%;

                background: white;

                flex-direction: column;

                padding: 25px;

                display: none;

                border-bottom: 1px solid #eee;
            }

            .nav-links.active {
                display: flex;
            }

            .menu-btn {
                display: block;
            }

            .nav-actions .login-btn,
            .nav-actions .signup-btn {
                display: none;
            }

        }

        @media (max-width: 600px) {

            .navbar {
                padding: 15px 5%;
            }

            .hero {
                padding: 60px 7%;
            }

            .section {
                padding: 70px 7%;
            }

            .section-header h2,
            .trending h2,
            .newsletter h2 {
                font-size: 2rem;
            }

            .newsletter-form {
                flex-direction: column;
            }

            .stats {
                gap: 20px;
            }

            .hero-card {
                padding: 30px;
            }

        }

        /* =========================
           ANIMATION
        ========================== */

        @keyframes fadeIn {

            from {
                opacity: 0;
                transform: translateY(-10px);
            }

            to {
                opacity: 1;
                transform: translateY(0);
            }

        }

    </style>