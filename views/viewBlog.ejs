<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title><%= blog.title %> | INKORA</title>
    <meta name="description" content="<%= (blog.content || '').substring(0, 150).replace(/[#*`_]/g, '') %>">

    <%- include("./partials/style.ejs") %>

    <style>
        .article-page {
            min-height: 85vh;
            padding: 40px 8% 100px;
            position: relative;
            z-index: 1;
            max-width: 900px;
            margin: 0 auto;
        }

        /* BACK NAVIGATION */
        .article-back-nav {
            margin-bottom: 32px;
            display: flex;
            align-items: center;
            justify-content: space-between;
        }

        .back-btn {
            color: var(--text-secondary);
            font-size: 14px;
            font-weight: 500;
            text-decoration: none;
            display: flex;
            align-items: center;
            gap: 6px;
            padding: 6px 12px;
            border-radius: 8px;
            transition: var(--transition-fast);
        }

        .back-btn:hover {
            color: var(--text-primary);
            background: var(--bg-glass-hover);
            transform: translateX(-3px);
        }

        .share-btn {
            background: var(--bg-card);
            border: 1px solid var(--border-subtle);
            color: var(--text-secondary);
            font-size: 13px;
            font-weight: 500;
            padding: 6px 14px;
            border-radius: 20px;
            cursor: pointer;
            display: flex;
            align-items: center;
            gap: 6px;
            transition: var(--transition-fast);
        }

        .share-btn:hover {
            border-color: var(--accent-secondary);
            color: var(--text-primary);
            transform: translateY(-1px);
        }

        /* ARTICLE HEADER */
        .article-header {
            margin-bottom: 36px;
        }

        .category-tag {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            background: var(--hero-tag-bg);
            color: var(--accent-tertiary);
            border: 1px solid var(--hero-tag-border);
            padding: 6px 16px;
            border-radius: 20px;
            font-size: 12px;
            font-weight: 700;
            letter-spacing: 1px;
            text-transform: uppercase;
            margin-bottom: 20px;
        }

        .article-main-title {
            font-family: var(--font-heading);
            font-size: clamp(2.2rem, 4.5vw, 3.4rem);
            font-weight: 800;
            line-height: 1.18;
            letter-spacing: -1.2px;
            color: var(--text-primary);
            margin-bottom: 24px;
        }

        .author-meta-card {
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 16px 20px;
            background: var(--bg-glass);
            border: 1px solid var(--border-subtle);
            border-radius: 16px;
            margin-bottom: 32px;
            flex-wrap: wrap;
            gap: 14px;
        }

        .author-info-left {
            display: flex;
            align-items: center;
            gap: 12px;
        }

        .author-large-avatar {
            width: 44px;
            height: 44px;
            border-radius: 50%;
            background: var(--gradient-primary);
            color: white;
            font-size: 18px;
            font-weight: 800;
            display: flex;
            align-items: center;
            justify-content: center;
            box-shadow: 0 4px 15px var(--accent-glow);
        }

        .author-details {
            display: flex;
            flex-direction: column;
        }

        .author-full-name {
            font-size: 15px;
            font-weight: 700;
            color: var(--text-primary);
        }

        .article-published-date {
            font-size: 12.5px;
            color: var(--text-muted);
        }

        .article-stats-right {
            display: flex;
            align-items: center;
            gap: 16px;
            font-size: 13px;
            color: var(--text-muted);
            font-weight: 500;
        }

        /* FEATURED IMAGE COVER */
        .article-cover-wrapper {
            width: 100%;
            max-height: 460px;
            border-radius: 20px;
            overflow: hidden;
            border: 1px solid var(--border-subtle);
            margin-bottom: 40px;
            background: var(--bg-card);
            box-shadow: var(--card-shadow);
        }

        .article-cover-img {
            width: 100%;
            height: 100%;
            max-height: 460px;
            object-fit: cover;
            display: block;
        }

        /* ARTICLE BODY CONTENT */
        .article-body-content {
            font-size: 17px;
            line-height: 1.85;
            color: var(--text-primary);
        }

        .article-body-content p {
            margin-bottom: 24px;
            color: var(--text-primary);
        }

        .article-body-content h1,
        .article-body-content h2,
        .article-body-content h3 {
            font-family: var(--font-heading);
            color: var(--text-primary);
            margin: 36px 0 16px;
            letter-spacing: -0.5px;
        }

        .article-body-content h1 { font-size: 2rem; font-weight: 700; }
        .article-body-content h2 { font-size: 1.6rem; font-weight: 700; }
        .article-body-content h3 { font-size: 1.3rem; font-weight: 600; }

        .article-body-content blockquote {
            border-left: 4px solid var(--accent-primary);
            padding: 16px 24px;
            margin: 28px 0;
            background: rgba(124, 58, 237, 0.08);
            border-radius: 0 12px 12px 0;
            font-style: italic;
            font-size: 18px;
            color: var(--text-primary);
            line-height: 1.7;
        }

        .article-body-content code {
            font-family: 'Fira Code', monospace;
            background: var(--bg-card);
            border: 1px solid var(--border-subtle);
            padding: 2px 7px;
            border-radius: 6px;
            font-size: 14px;
            color: var(--accent-tertiary);
        }

        .article-body-content pre {
            background: rgba(10, 10, 15, 0.85);
            border: 1px solid var(--border-subtle);
            border-radius: 12px;
            padding: 20px;
            overflow-x: auto;
            margin: 28px 0;
        }

        .article-body-content pre code {
            background: transparent;
            border: none;
            padding: 0;
            color: #e2e8f0;
            font-size: 14.5px;
            line-height: 1.6;
        }

        .article-body-content ul,
        .article-body-content ol {
            margin: 16px 0 24px 28px;
        }

        .article-body-content li {
            margin-bottom: 8px;
            padding-left: 4px;
        }

        .article-body-content hr {
            border: none;
            height: 1px;
            background: var(--border-subtle);
            margin: 40px 0;
        }

        .article-body-content a {
            color: var(--accent-secondary);
            text-decoration: underline;
            text-underline-offset: 3px;
            transition: var(--transition-fast);
        }

        .article-body-content a:hover {
            color: var(--accent-tertiary);
        }

        /* ARTICLE FOOTER AUTHOR SIGNATURE */
        .article-footer-author {
            padding: 32px;
            background: var(--bg-glass);
            border: 1px solid var(--border-subtle);
            border-radius: 20px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 20px;
            flex-wrap: wrap;
        }

        .author-box-left {
            display: flex;
            align-items: center;
            gap: 16px;
        }

        .author-box-meta h4 {
            font-family: var(--font-heading);
            font-size: 1.1rem;
            color: var(--text-primary);
            margin-bottom: 4px;
        }

        .author-box-meta p {
            color: var(--text-muted);
            font-size: 13px;
        }

        .author-cta-btn {
            background: var(--gradient-primary);
            color: white;
            padding: 10px 22px;
            border-radius: 12px;
            font-size: 14px;
            font-weight: 600;
            text-decoration: none;
            display: inline-flex;
            align-items: center;
            gap: 6px;
            box-shadow: 0 4px 15px var(--accent-glow);
            transition: var(--transition-smooth);
        }

        .author-cta-btn:hover {
            transform: translateY(-2px);
            box-shadow: 0 6px 22px var(--accent-glow);
        }

        /* TOAST */
        .comments-section {
            margin-top: 54px;
            padding-top: 30px;
            border-top: 1px solid var(--border-subtle);
        }

        .comments-heading {
            font-family: var(--font-heading);
            font-size: clamp(1.5rem, 2vw, 2rem);
            font-weight: 700;
            letter-spacing: -0.7px;
            margin-bottom: 20px;
            color: var(--text-primary);
        }

        .comment-form-wrap {
            background: var(--bg-glass);
            border: 1px solid var(--border-subtle);
            border-radius: 20px;
            padding: 10px;
            margin-bottom: 15px;
            box-shadow: var(--card-shadow);
        }

        .comment-form {
            display: flex;
            flex-direction: column;
            gap: 14px;
        }

        .comment-textarea {
            width: 100%;
            min-height: 80px;
            max-height: 150px;
            resize: vertical;
            border: 1px solid var(--border-subtle);
            background: var(--bg-input);
            color: var(--text-primary);
            border-radius: 14px;
            padding: 16px 18px;
            font-size: 15px;
            font-family: var(--font-body);
            line-height: 1.7;
            outline: none;
            transition: var(--transition-fast);
        }

        .comment-textarea:focus {
            border-color: var(--accent-secondary);
            box-shadow: 0 0 0 3px rgba(168, 85, 247, 0.12);
        }

        .comment-submit-row {
            display: flex;
            justify-content: flex-end;
        }

        .comment-submit-btn {
            background: var(--gradient-primary);
            color: white;
            font-weight: 700;
            padding: 12px 22px;
            border-radius: 12px;
            box-shadow: 0 12px 24px rgba(124, 58, 237, 0.25);
            transition: var(--transition-smooth);
        }

        .comment-submit-btn:hover {
            transform: translateY(-2px);
            box-shadow: 0 16px 32px rgba(124, 58, 237, 0.3);
        }

        .no-comments-box {
            display: flex;
            align-items: center;
            justify-content: center;
            color: var(--text-secondary);
            font-size: 1rem;
            font-weight: 600;
            letter-spacing: 0.2px;
            text-align: center;
            padding: 10px;
            margin-bottom: 15px;
        }

        .comment-card {
            background: var(--bg-glass);
            border: 1px solid var(--border-subtle);
            border-radius: 18px;
            padding: 10px;
            box-shadow: var(--card-shadow);
            margin-bottom: 15px;
        }

        .comment-header {
            display: flex;
            align-items: center;
            justify-content: space-between;
            margin-bottom: 12px;
        }

        .comment-user {
            display: flex;
            align-items: center;
            gap: 12px;
        }

        .comment-avatar {
            width: 38px;
            height: 38px;
            border-radius: 50%;
            background: var(--gradient-primary);
            display: grid;
            place-items: center;
            color: white;
            font-weight: 700;
            font-size: 14px;
            box-shadow: 0 6px 18px var(--accent-glow);
        }

        .comment-meta {
            display: flex;
            flex-direction: column;
        }

        .comment-username {
            font-size: 14px;
            font-weight: 700;
            color: var(--text-primary);
        }

        .comment-date {
            font-size: 12px;
            color: var(--text-muted);
        }

        .comment-content {
            color: var(--text-primary);
            line-height: 1.7;
            font-size: 15px;
            white-space: pre-wrap;
            word-break: break-word;
        }

        .toast {
            position: fixed;
            bottom: 30px;
            right: 30px;
            background: var(--bg-secondary);
            color: var(--text-primary);
            border: 1px solid var(--border-accent);
            padding: 12px 20px;
            border-radius: 12px;
            font-size: 14px;
            font-weight: 500;
            box-shadow: 0 10px 30px rgba(0,0,0,0.4);
            opacity: 0;
            transform: translateY(20px);
            transition: all var(--transition-smooth);
            pointer-events: none;
            z-index: 10000;
        }

        .toast.show {
            opacity: 1;
            transform: translateY(0);
        }

        @media (max-width: 600px) {
            .article-page {
                padding: 24px 5% 60px;
            }

            .article-footer-author {
                flex-direction: column;
                align-items: flex-start;
            }
        }
    </style>
</head>

<body>

    <!-- FLOATING ORBS -->
    <div class="orb orb-1"></div>
    <div class="orb orb-2"></div>

    <%- include("./partials/navbar.ejs") %>

    <main class="article-page">

        <!-- BACK & SHARE NAV -->
        <div class="article-back-nav">
            <a href="/blogs" class="back-btn">
                ← All Stories
            </a>

            <button type="button" class="share-btn" id="shareStoryBtn">
                <span>🔗</span>
                <span>Copy Link</span>
            </button>
        </div>

        <%
            // Reading time calculation
            var words = (blog.content || '').trim().split(/\s+/).length;
            var readMinutes = Math.max(1, Math.ceil(words / 200));

            // Date format
            var pubDate = 'Recent';
            if (blog.createdAt) {
                var d = new Date(blog.createdAt);
                pubDate = d.toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' });
            }
        %>

        <!-- ARTICLE HEADER -->
        <header class="article-header">
            <span class="category-tag">
                <%= blog.category || 'Perspectives' %>
            </span>

            <h1 class="article-main-title">
                <%= blog.title %>
            </h1>

            <div class="author-meta-card">
                <div class="author-info-left">
                    <div class="account-btn">
                    <img src="<%= blog.createdBy.profilePicture %>" alt="Profilepic" class="profilepic"/>
                </div>
                    <div class="author-details">
                        <span class="author-full-name"><%= blog.author || 'Anonymous Writer' %></span>
                        <span class="article-published-date"><%= pubDate %></span>
                    </div>
                </div>

                <div class="article-stats-right">
                    <span>📖 ~<%= readMinutes %> min read</span>
                    <span>📝 <%= words %> words</span>
                </div>
            </div>
        </header>

        <!-- COVER IMAGE (IF AVAILABLE) -->
        <% if (blog.thumbnail && blog.thumbnail.trim() !== '') { %>
            <div class="article-cover-wrapper">
                <img 
                    src="<%= blog.thumbnail %>" 
                    alt="<%= blog.title %>" 
                    class="article-cover-img"
                    onerror="this.parentElement.style.display='none';"
                >
            </div>
        <% } %>

        <!-- RAW CONTENT FOR MARKDOWN RENDERING -->
        <div id="rawContent" style="display: none;"><%= blog.content %></div>

        <!-- RENDERED ARTICLE CONTENT -->
        <article class="article-body-content" id="renderedArticleBody">
            <!-- Rendered by client-side markdown parser for highest fidelity -->
        </article>

        <section class="comments-section">
            <h3 class="comments-heading">Comments</h3>

            <div class="comment-form-wrap">
                <form action="/comment/<%= blog._id %>" method="post" class="comment-form">
                    <textarea
                        name="content"
                        class="comment-textarea"
                        placeholder="Share your thoughts..."
                        maxlength="150"
                        required
                    ></textarea>

                    <div class="comment-submit-row">
                        <button type="submit" class="comment-submit-btn">
                            <span>✍ Add Comment</span>
                        </button>
                    </div>
                </form>
            </div>

            <% if (locals.comments && comments.length) { %>
                <% comments.forEach(function(comment) { %>
                    <%- include("./partials/commentCard.ejs", { comment: comment }) %>
                <% }); %>
            <% } else { %>
                <div class="no-comments-box">No comments yet!!</div>
            <% } %>
        </section>

        <!-- AUTHOR SIGNATURE CARD -->
        <footer class="article-footer-author">
            <div class="author-box-left">
                <div class="account-btn">
                    <img src="<%= blog.createdBy.profilePicture %>" alt="Profilepic" class="profilepic"/>
                </div>
                <div class="author-box-meta">
                    <h4>Written by <%= blog.author || 'INKORA Thinker' %></h4>
                    <p>Published on INKORA — Where ideas find their voice.</p>
                </div>
            </div>

            <a href="/blogs/<%= blog.author %>" class="author-cta-btn">
                <span>📚</span>
                <span>More stories</span>
            </a>
        </footer>

    </main>

    <!-- TOAST NOTIFICATION -->
    <div class="toast" id="shareToast">Link copied to clipboard!</div>

    <%- include("./partials/footer.ejs") %>

    <%- include("./partials/script.ejs") %>

    <!-- CLIENT MARKDOWN PARSER -->
    <script>
        document.addEventListener('DOMContentLoaded', () => {
            const rawContent = document.getElementById('rawContent')?.textContent || '';
            const articleBody = document.getElementById('renderedArticleBody');

            function renderMarkdown(md) {
                if (!md || md.trim() === '') return '<p>No content available for this story.</p>';

                let html = md
                    .replace(/&/g, '&amp;')
                    .replace(/</g, '&lt;')
                    .replace(/>/g, '&gt;')
                    .replace(/```([\s\S]*?)```/g, '<pre><code>$1</code></pre>')
                    .replace(/`([^`]+)`/g, '<code>$1</code>')
                    .replace(/^### (.*$)/gim, '<h3>$1</h3>')
                    .replace(/^## (.*$)/gim, '<h2>$1</h2>')
                    .replace(/^# (.*$)/gim, '<h1>$1</h1>')
                    .replace(/^\> (.*$)/gim, '<blockquote>$1</blockquote>')
                    .replace(/^---$/gim, '<hr>')
                    .replace(/\*\*(.*?)\*\*/g, '<strong>$1</strong>')
                    .replace(/\*(.*?)\*/g, '<em>$1</em>')
                    .replace(/\[([^\]]+)\]\(([^)]+)\)/g, '<a href="$2" target="_blank" rel="noopener noreferrer">$1</a>')
                    .replace(/^\- (.*$)/gim, '<li>$1</li>')
                    .replace(/(<li>.*<\/li>)/gim, '<ul>$1</ul>')
                    .replace(/\n\n/g, '</p><p>')
                    .replace(/\n/g, '<br>');

                return `<p>${html}</p>`;
            }

            if (articleBody) {
                articleBody.innerHTML = renderMarkdown(rawContent);
            }

            // Share / Copy link
            const shareBtn = document.getElementById('shareStoryBtn');
            const shareToast = document.getElementById('shareToast');

            if (shareBtn) {
                shareBtn.addEventListener('click', () => {
                    navigator.clipboard.writeText(window.location.href).then(() => {
                        if (shareToast) {
                            shareToast.classList.add('show');
                            setTimeout(() => {
                                shareToast.classList.remove('show');
                            }, 2500);
                        }
                    }).catch(() => {
                        alert('URL: ' + window.location.href);
                    });
                });
            }
        });
    </script>

</body>
</html>
