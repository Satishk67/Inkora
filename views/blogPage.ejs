<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title><%= locals.author ? `${author}'s Stories | INKORA` : 'Explore Stories | INKORA' %></title>
    <meta name="description" content="Discover stories, ideas, and perspectives from thinkers and writers on INKORA.">

    <%- include("./partials/style.ejs") %>

    <style>
        .blog-feed-page {
            min-height: 80vh;
            padding: 40px 8% 80px;
            position: relative;
            z-index: 1;
        }

        /* HEADER BANNER */
        .feed-header {
            margin-bottom: 40px;
            text-align: center;
            display: flex;
            flex-direction: column;
            align-items: center;
        }

        .feed-tag {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            background: var(--hero-tag-bg);
            color: var(--accent-tertiary);
            border: 1px solid var(--hero-tag-border);
            padding: 6px 16px;
            border-radius: 20px;
            font-size: 13px;
            font-weight: 600;
            margin-bottom: 16px;
        }

        .feed-tag .dot {
            width: 7px;
            height: 7px;
            background: var(--accent-secondary);
            border-radius: 50%;
            animation: pulse 2s infinite;
        }

        .feed-header h1 {
            font-family: var(--font-heading);
            font-size: clamp(2.2rem, 4vw, 3.2rem);
            font-weight: 700;
            letter-spacing: -1px;
            margin-bottom: 12px;
        }

        .feed-header p {
            color: var(--text-secondary);
            font-size: 17px;
            max-width: 600px;
            line-height: 1.6;
        }

        /* CONTROLS BAR (SEARCH & ACTIONS) */
        .feed-controls {
            width: 100%;
            max-width: 900px;
            margin: 28px auto 0;
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 16px;
            flex-wrap: wrap;
        }

        .search-box {
            position: relative;
            flex: 1;
            min-width: 260px;
        }

        .search-icon {
            position: absolute;
            left: 16px;
            top: 50%;
            transform: translateY(-50%);
            color: var(--text-muted);
            font-size: 15px;
            pointer-events: none;
        }

        .search-input {
            width: 100%;
            background: var(--bg-input);
            border: 1px solid var(--border-subtle);
            border-radius: 30px;
            padding: 12px 18px 12px 42px;
            color: var(--text-primary);
            font-family: var(--font-body);
            font-size: 14px;
            outline: none;
            transition: var(--transition-fast);
        }

        .search-input:focus {
            border-color: var(--accent-secondary);
            background: var(--bg-input-focus);
            box-shadow: 0 0 0 4px var(--accent-glow);
        }

        .write-action-btn {
            background: var(--gradient-primary);
            color: white;
            padding: 12px 24px;
            border-radius: 30px;
            font-size: 14px;
            font-weight: 600;
            display: flex;
            align-items: center;
            gap: 6px;
            box-shadow: 0 4px 15px var(--accent-glow);
            transition: var(--transition-smooth);
            white-space: nowrap;
        }

        .write-action-btn:hover {
            transform: translateY(-2px);
            box-shadow: 0 6px 22px var(--accent-glow);
        }

        /* CATEGORY FILTER PILLS */
        .category-filters {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            flex-wrap: wrap;
            margin: 24px auto 40px;
            max-width: 900px;
        }

        .filter-pill {
            background: var(--bg-card);
            border: 1px solid var(--border-subtle);
            color: var(--text-secondary);
            font-size: 13px;
            font-weight: 500;
            padding: 7px 16px;
            border-radius: 24px;
            cursor: pointer;
            transition: var(--transition-fast);
            user-select: none;
        }

        .filter-pill:hover {
            background: var(--bg-glass-hover);
            color: var(--text-primary);
            border-color: var(--border-accent);
        }

        .filter-pill.active {
            background: var(--gradient-primary);
            color: white;
            border-color: transparent;
            box-shadow: 0 4px 15px var(--accent-glow);
        }

        /* GRID LAYOUT */
        .blog-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
            gap: 28px;
            width: 100%;
        }

        /* MINI CARD STYLING */
        .mini-card {
            background: var(--bg-glass);
            backdrop-filter: blur(16px);
            -webkit-backdrop-filter: blur(16px);
            border: 1px solid var(--border-subtle);
            border-radius: var(--card-radius);
            overflow: hidden;
            transition: var(--transition-spring);
            display: flex;
            flex-direction: column;
            position: relative;
        }

        .mini-card:hover {
            transform: translateY(-6px);
            border-color: var(--border-accent);
            box-shadow: var(--card-shadow);
        }

        .mini-card-link {
            display: flex;
            flex-direction: column;
            height: 100%;
            color: inherit;
            text-decoration: none;
        }

        .mini-card-cover {
            height: 180px;
            position: relative;
            background: var(--bg-card);
            overflow: hidden;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .mini-card-img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            transition: transform var(--transition-smooth);
        }

        .mini-card:hover .mini-card-img {
            transform: scale(1.05);
        }

        .mini-card-fallback {
            width: 100%;
            height: 100%;
            display: flex;
            align-items: center;
            justify-content: center;
            background: linear-gradient(135deg, rgba(124, 58, 237, 0.25), rgba(168, 85, 247, 0.1));
        }

        .fallback-icon {
            font-size: 42px;
            filter: drop-shadow(0 4px 10px var(--accent-glow));
        }

        .mini-card-badge {
            position: absolute;
            top: 14px;
            left: 14px;
            background: rgba(10, 10, 15, 0.75);
            backdrop-filter: blur(10px);
            -webkit-backdrop-filter: blur(10px);
            border: 1px solid var(--border-subtle);
            color: var(--accent-tertiary);
            font-size: 11px;
            font-weight: 700;
            letter-spacing: 0.8px;
            text-transform: uppercase;
            padding: 4px 10px;
            border-radius: 12px;
        }

        .mini-card-body {
            padding: 22px;
            display: flex;
            flex-direction: column;
            flex: 1;
            justify-content: space-between;
        }

        .mini-card-title {
            font-family: var(--font-heading);
            font-size: 1.18rem;
            font-weight: 600;
            line-height: 1.4;
            color: var(--text-primary);
            margin-bottom: 10px;
            display: -webkit-box;
            -webkit-line-clamp: 2;
            -webkit-box-orient: vertical;
            overflow: hidden;
            transition: color var(--transition-fast);
        }

        .mini-card:hover .mini-card-title {
            color: var(--accent-tertiary);
        }

        .mini-card-excerpt {
            color: var(--text-secondary);
            font-size: 13.5px;
            line-height: 1.6;
            margin-bottom: 20px;
            display: -webkit-box;
            -webkit-line-clamp: 3;
            -webkit-box-orient: vertical;
            overflow: hidden;
        }

        .mini-card-footer {
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding-top: 10px;
            border-top: 1px solid var(--border-subtle);
            margin-top: auto;
        }

        .author-block {
            display: flex;
            align-items: center;
            gap: 9px;
        }

        .author-meta {
            display: flex;
            flex-direction: column;
        }

        .author-name {
            font-size: 12.5px;
            font-weight: 600;
            color: var(--text-primary);
        }

        .post-date {
            font-size: 11px;
            color: var(--text-muted);
        }

        .reading-time {
            font-size: 11.5px;
            color: var(--text-muted);
            font-weight: 500;
        }

        /* EMPTY STATE */
        .empty-state {
            grid-column: 1 / -1;
            background: var(--bg-glass);
            border: 1px dashed var(--border-subtle);
            border-radius: var(--card-radius);
            padding: 60px 24px;
            text-align: center;
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 12px;
        }

        .empty-icon {
            font-size: 48px;
            margin-bottom: 8px;
        }

        .empty-state h3 {
            font-family: var(--font-heading);
            font-size: 1.5rem;
            color: var(--text-primary);
        }

        .empty-state p {
            color: var(--text-secondary);
            font-size: 14px;
            max-width: 420px;
            margin-bottom: 12px;
        }

        @media (max-width: 600px) {
            .blog-feed-page {
                padding: 30px 5% 60px;
            }

            .feed-controls {
                flex-direction: column;
                align-items: stretch;
            }

            .write-action-btn {
                justify-content: center;
            }
        }
    </style>
</head>

<body>

    <!-- FLOATING ORBS -->
    <div class="orb orb-1"></div>
    <div class="orb orb-2"></div>

    <%- include("./partials/navbar.ejs") %>

    <main class="blog-feed-page">
            <!-- SEARCH & WRITE ACTIONS -->
            <form class="feed-controls" id="blogSearchForm" method="GET" action="/blogs/user">
                <div class="search-box">
                    <span class="search-icon">🔍</span>
                    <input 
                        type="text" 
                        id="feedSearchInput" 
                        name="userName"
                        class="search-input" 
                        placeholder="Search by author's userName"
                        required
                    >
                </div>

                <button type="submit" class="write-action-btn">
                    <span>🔍 Search</span>
                </button>

                <a href="/blogs/create" style="text-decoration: none;">
                    <button type="button" class="write-action-btn">
                        <span>✍ Start Writing</span>
                    </button>
                </a>
            </form>

            <!-- CATEGORY FILTER PILLS -->
            <div class="category-filters" id="categoryFilters">
                <button type="button" class="filter-pill active" data-filter="all">All Stories</button>
                <button type="button" class="filter-pill" data-filter="technology">Technology</button>
                <button type="button" class="filter-pill" data-filter="ai">AI</button>
                <button type="button" class="filter-pill" data-filter="startups">Startups</button>
                <button type="button" class="filter-pill" data-filter="programming">Programming</button>
                <button type="button" class="filter-pill" data-filter="productivity">Productivity</button>
                <button type="button" class="filter-pill" data-filter="design">Design</button>
                <button type="button" class="filter-pill" data-filter="psychology">Psychology</button>
            </div>
        </header>

        <!-- BLOG MINIATURES GRID -->
        <div class="blog-grid" id="blogGrid">

            <% if (locals.blogs && locals.blogs.length > 0) { %>
                <% blogs.forEach(function(blog) { %>
                    <%- include("./partials/card.ejs", { blog: blog }) %>
                <% }); %>
            <% } else { %>
                <div class="empty-state">
                    <div class="empty-icon">📝</div>
                    <h3>No stories published yet</h3>
                    <p>Be the first one to share your ideas, insights, or stories with the INKORA community.</p>
                    <a href="/blogs/create" style="text-decoration: none;">
                        <button class="primary-btn">
                            ✍ Publish First Story
                        </button>
                    </a>
                </div>
            <% } %>

        </div>

    </main>

    <%- include("./partials/footer.ejs") %>

    <%- include("./partials/script.ejs") %>

    <!-- CLIENT FILTER LOGIC -->
    <script>
        document.addEventListener('DOMContentLoaded', () => {
            const searchInput = document.getElementById('feedSearchInput');
            const filterPills = document.querySelectorAll('.filter-pill');
            const cards = document.querySelectorAll('.mini-card');

            let currentCategory = 'all';
            let currentSearch = '';

            function filterCards() {
                let visibleCount = 0;

                cards.forEach((card) => {
                    const cardCategory = (card.getAttribute('data-category') || '').toLowerCase();
                    const titleText = (card.querySelector('.mini-card-title')?.textContent || '').toLowerCase();
                    const excerptText = (card.querySelector('.mini-card-excerpt')?.textContent || '').toLowerCase();

                    const matchesCategory = currentCategory === 'all' || cardCategory.includes(currentCategory);
                    const matchesSearch = currentSearch === '' || titleText.includes(currentSearch) || excerptText.includes(currentSearch);

                    if (matchesCategory && matchesSearch) {
                        card.style.display = 'flex';
                        visibleCount++;
                    } else {
                        card.style.display = 'none';
                    }
                });
            }

            if (searchInput) {
                searchInput.addEventListener('input', (e) => {
                    currentSearch = e.target.value.trim().toLowerCase();
                    filterCards();
                });
            }

            filterPills.forEach((pill) => {
                pill.addEventListener('click', () => {
                    filterPills.forEach(p => p.classList.remove('active'));
                    pill.classList.add('active');
                    currentCategory = pill.getAttribute('data-filter').toLowerCase();
                    filterCards();
                });
            });
        });
    </script>

</body>
</html>
