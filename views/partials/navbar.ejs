<nav class="navbar" id="mainNavbar">

    <a href="/" class="logo">
        <div class="logo-icon">I</div>
        INKORA
    </a>

    <div class="nav-actions">

        <% if (!user) { %>

            <a href="/user/login">
                <button class="login-btn">
                    Log in
                </button>
            </a>

            <a href="/user/signup">
                <button class="signup-btn">
                    Sign up
                </button>
            </a>

        <% } else { %>

            <!-- ACCOUNT -->

            <div class="account">

                <button class="account-btn" id="accountBtn">
                    <img
                        src="<%= user.profilePicture %>"
                        alt="Profile picture"
                        class="profilepic"
                    >
                </button>


                <div class="account-menu" id="accountMenu">

                    <a href="/" style="font-weight: 700; color: var(--text-primary);" class="menu-link">
                        <span style="margin-right: 8px;">👤</span>
                        <%= user.userName %>
                    </a>

                    <a href="/blogs/<%= user.userName %>" style="font-weight: 700; color: var(--text-primary);" class="menu-link">
                        <span style="margin-right: 8px;">💹</span>
                        Dashboard
                    </a>

                    <!-- APPEARANCE DROPDOWN -->
                    <div class="theme-dropdown-wrapper">
                        <button type="button" class="theme-toggle-btn" id="appearanceBtn" aria-expanded="false">
                            <span class="theme-toggle-label">
                                <span style="margin-right: 8px;">🌓</span>
                                Appearance
                            </span>
                            <span class="menu-arrow" id="appearanceArrow">›</span>
                        </button>

                        <div class="theme-submenu" id="themeSubmenu">
                            <button type="button" class="theme-option" data-theme-value="light" id="themeLightBtn">
                                <span class="theme-option-left">
                                    <span class="theme-option-icon">☀️</span>
                                    <span>Light theme</span>
                                </span>
                                <span class="theme-check" id="checkLight">✓</span>
                            </button>

                            <button type="button" class="theme-option" data-theme-value="dark" id="themeDarkBtn">
                                <span class="theme-option-left">
                                    <span class="theme-option-icon">🌙</span>
                                    <span>Dark theme</span>
                                </span>
                                <span class="theme-check" id="checkDark">✓</span>
                            </button>
                        </div>
                    </div>

                    <a href="/user/logout" class="menu-link">
                        <span style="margin-right: 8px;">🚪</span>
                        Logout
                    </a>

                </div>

            </div>

        <% } %>

    </div>

</nav>